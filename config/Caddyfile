{
	admin off
	auto_https disable_redirects
	email {$IMESSAGE_PROXY_ACME_EMAIL}
	http_port {$IMESSAGE_PROXY_HTTP_PORT}
	https_port {$IMESSAGE_PROXY_HTTPS_PORT}
	log default {
		output file "{$IMESSAGE_PROXY_EDGE_LOG_PATH}" {
			mode 0600
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format filter {
			wrap json
			fields {
				request delete
				uri delete
			}
		}
	}
	servers {
		# Go reserves about 4 KiB beyond this parser budget; 12 KiB keeps the
		# effective rejection boundary close to the documented 16 KiB ceiling.
		max_header_size 12KiB
		protocols h1 h2
		timeouts {
			read_body 15s
			read_header 5s
			write 200s
			idle 1m
		}
	}
}

(public_response_headers) {
	header {
		-Server
		-Alt-Svc
		-Access-Control-Allow-Credentials
		-Access-Control-Allow-Headers
		-Access-Control-Allow-Methods
		-Access-Control-Allow-Origin
		Cache-Control "no-store"
		Content-Security-Policy "default-src 'none'; base-uri 'none'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self'; script-src 'self'; style-src 'self'"
		Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), publickey-credentials-get=(), usb=()"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-Robots-Tag "noindex, nofollow, noarchive"
	}
}

http:// {
	bind {$IMESSAGE_PROXY_PUBLIC_BIND}

	route {
		import public_response_headers

		@canonical_host host {$IMESSAGE_PROXY_API_HOST}
		redir @canonical_host https://{$IMESSAGE_PROXY_API_HOST}{uri} 308

		respond 421
	}
}

https://{$IMESSAGE_PROXY_API_HOST} {
	bind {$IMESSAGE_PROXY_PUBLIC_BIND}

	route {
		import public_response_headers

		@api path /api /api/*
		handle @api {
			request_body {
				max_size 64KiB
			}
			request_header -Cookie
			request_header -X-API-*

			reverse_proxy "unix/{$IMESSAGE_PROXY_SOCKET_PATH}" {
				header_up X-API-Client-IP {http.request.remote.host}
				header_down -Server
				header_down -Access-Control-Allow-Credentials
				header_down -Access-Control-Allow-Headers
				header_down -Access-Control-Allow-Methods
				header_down -Access-Control-Allow-Origin
				transport http {
					dial_timeout 3s
					response_header_timeout 195s
				}
			}
		}

		@ui path / /index.html /app.js /styles.css
		handle @ui {
			root * "{$IMESSAGE_PROXY_UI_DIR}"
			file_server
		}

		respond 404
	}

	handle_errors {
		@api_error path /api /api/*
		handle @api_error {
			header {
				-Server
				-Alt-Svc
				-Access-Control-Allow-Credentials
				-Access-Control-Allow-Headers
				-Access-Control-Allow-Methods
				-Access-Control-Allow-Origin
				Cache-Control "no-store"
				Content-Security-Policy "default-src 'none'; base-uri 'none'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self'; script-src 'self'; style-src 'self'"
				Content-Type "application/problem+json"
				Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), publickey-credentials-get=(), usb=()"
				Referrer-Policy "no-referrer"
				Strict-Transport-Security "max-age=31536000"
				X-Content-Type-Options "nosniff"
				X-Frame-Options "DENY"
				X-Robots-Tag "noindex, nofollow, noarchive"
			}

			respond `{"type":"about:blank","title":"Edge request failed","status":{http.error.status_code},"detail":"The HTTPS edge could not complete the API request.","request_id":"{http.request.uuid}"}` {http.error.status_code}
		}

		respond {http.error.status_code}
	}
}
