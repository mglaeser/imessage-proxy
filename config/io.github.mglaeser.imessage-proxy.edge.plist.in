<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Rendered by bin/imessage-proxy. This template never contains credentials. -->
<dict>
	<key>Label</key>
	<string>io.github.mglaeser.imessage-proxy.edge</string>
	<key>ProgramArguments</key>
	<array>
		<string>__CADDY_BIN__</string>
		<string>run</string>
		<string>--config</string>
		<string>__CADDYFILE__</string>
		<string>--adapter</string>
		<string>caddyfile</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>IMESSAGE_PROXY_ACME_EMAIL</key>
		<string>__ACME_EMAIL__</string>
		<key>IMESSAGE_PROXY_EDGE_LOG_PATH</key>
		<string>__EDGE_LOG_PATH__</string>
		<key>IMESSAGE_PROXY_HTTP_PORT</key>
		<string>__HTTP_PORT__</string>
		<key>IMESSAGE_PROXY_HTTPS_PORT</key>
		<string>__HTTPS_PORT__</string>
		<key>IMESSAGE_PROXY_PUBLIC_BIND</key>
		<string>__PUBLIC_BIND__</string>
		<key>IMESSAGE_PROXY_API_HOST</key>
		<string>__API_HOST__</string>
		<key>IMESSAGE_PROXY_SOCKET_PATH</key>
		<string>__SOCKET_PATH__</string>
		<key>IMESSAGE_PROXY_UI_DIR</key>
		<string>__UI_DIR__</string>
		<key>XDG_CONFIG_HOME</key>
		<string>__CADDY_CONFIG__</string>
		<key>XDG_DATA_HOME</key>
		<string>__CADDY_DATA__</string>
	</dict>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ProcessType</key>
	<string>Background</string>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/dev/null</string>
	<key>StandardOutPath</key>
	<string>/dev/null</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>WorkingDirectory</key>
	<string>__WORKING_DIRECTORY__</string>
</dict>
</plist>
