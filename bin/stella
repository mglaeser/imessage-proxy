#!/usr/bin/env bash
set -Eeuo pipefail

# Deprecated compatibility entry point for Stella v0.1.x automation.
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
readonly script_dir
if [[ ! -x "$script_dir/imessage-proxy" ]]; then
  printf 'ERROR: cannot find the imessage-proxy command next to this compatibility wrapper\n' >&2
  exit 78
fi
exec "$script_dir/imessage-proxy" "$@"
