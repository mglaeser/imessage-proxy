#!/usr/bin/env bash
set -Eeuo pipefail
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin"
export LC_ALL=C
umask 077

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command is missing: $1"
}

require_macos() {
  [[ "$(uname -s)" == Darwin ]] || die 'iMessage Proxy runs only on macOS'
  [[ "$EUID" -ne 0 ]] || die 'run iMessage Proxy as the Messages.app user, not root'
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
readonly SCRIPT_DIR
source_dir="${IMESSAGE_PROXY_SOURCE_DIR:-}"
if [[ -z "$source_dir" && -f "$SCRIPT_DIR/../src/imessage-proxy-server.m" ]]; then
  source_dir="$(cd "$SCRIPT_DIR/.." && pwd -P)"
elif [[ -z "$source_dir" && -f "$SCRIPT_DIR/../share/imessage-proxy/src/imessage-proxy-server.m" ]]; then
  source_dir="$(cd "$SCRIPT_DIR/../share/imessage-proxy" && pwd -P)"
fi
readonly SOURCE_DIR="$source_dir"
[[ -n "$SOURCE_DIR" && -f "$SOURCE_DIR/VERSION" ]] ||
  die 'cannot find iMessage Proxy assets; set IMESSAGE_PROXY_SOURCE_DIR'

VERSION="$(< "$SOURCE_DIR/VERSION")"
readonly VERSION
[[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
  die 'VERSION must contain one semantic version'

readonly ROOT="${IMESSAGE_PROXY_HOME:-$HOME/Library/Application Support/iMessage Proxy}"
readonly STATE="$ROOT/state"
readonly PRIVATE="$ROOT/private"
readonly RUN_DIR="$ROOT/run"
readonly LOG_DIR="$STATE/logs"
readonly EDGE_LOG="$LOG_DIR/edge.log"
readonly BIN_DIR="$STATE/bin"
readonly SERVER_BIN="$BIN_DIR/imessage-proxy-server"
readonly IMSG_BIN="$BIN_DIR/imsg"
readonly DATABASE_PATH="$PRIVATE/api-keys.sqlite3"
readonly MESSAGES_DATABASE_PATH="$HOME/Library/Messages/chat.db"
readonly TARGETS_FILE="$PRIVATE/allowed-targets.txt"
readonly SOCKET_PATH="$RUN_DIR/server.sock"
readonly CADDY_STATE="$STATE/caddy"
readonly CADDY_DATA="$CADDY_STATE/data"
readonly CADDY_CONFIG="$CADDY_STATE/config"
readonly CADDYFILE="$CADDY_STATE/Caddyfile"
readonly UI_DIR="$CADDY_STATE/ui"
readonly CADDY_BIN="$BIN_DIR/caddy"
readonly SERVER_LABEL='io.github.mglaeser.imessage-proxy'
readonly SERVER_PLIST_STATE="$STATE/io.github.mglaeser.imessage-proxy.plist"
readonly SERVER_PLIST_TARGET="$HOME/Library/LaunchAgents/io.github.mglaeser.imessage-proxy.plist"
readonly EDGE_LABEL='io.github.mglaeser.imessage-proxy.edge'
readonly EDGE_PLIST_STATE="$STATE/io.github.mglaeser.imessage-proxy.edge.plist"
readonly EDGE_PLIST_TARGET="$HOME/Library/LaunchAgents/io.github.mglaeser.imessage-proxy.edge.plist"
readonly EXPECTED_IMSG_VERSION='0.13.4'
readonly EXPECTED_CADDY_VERSION='2.11.4'
readonly SERVER_READ_TIMEOUT_SECONDS=30
readonly SERVER_START_TIMEOUT_SECONDS=50

require_safe_runtime_root() {
  local ancestor basename
  [[ -n "${HOME:-}" && "$HOME" == /* && "$HOME" != / && "$HOME" != */ &&
    "$HOME" != *//* && "$HOME" != *'/./'* && "$HOME" != */. &&
    "$HOME" != *'/../'* && "$HOME" != */.. ]] ||
    die 'HOME must be a normalized absolute user directory'
  [[ "$ROOT" == "$HOME/"* && "$ROOT" != */ && "$ROOT" != *//* &&
    "$ROOT" != *'/./'* && "$ROOT" != */. && "$ROOT" != *'/../'* && "$ROOT" != */.. ]] ||
    die 'IMESSAGE_PROXY_HOME must be a normalized absolute directory below HOME'
  basename="${ROOT##*/}"
  [[ "$basename" == 'iMessage Proxy' || "$basename" == imessage-proxy ]] ||
    die 'IMESSAGE_PROXY_HOME must end in iMessage Proxy or imessage-proxy'
  [[ -d "$HOME" && ! -L "$HOME" ]] || die 'HOME must be a real directory, not a symlink'

  ancestor="$ROOT"
  while [[ "$ancestor" != "$HOME" ]]; do
    [[ "$ancestor" == "$HOME/"* ]] || die 'runtime path escapes HOME'
    if [[ -e "$ancestor" || -L "$ancestor" ]]; then
      [[ -d "$ancestor" && ! -L "$ancestor" ]] ||
        die "runtime path component must be a real directory: $ancestor"
    fi
    ancestor="${ancestor%/*}"
  done
}

prepare_runtime_directories() {
  local path
  local -a paths=(
    "$ROOT" "$STATE" "$PRIVATE" "$RUN_DIR" "$LOG_DIR" "$BIN_DIR"
    "$CADDY_STATE" "$CADDY_DATA" "$CADDY_CONFIG" "$UI_DIR"
  )
  require_safe_runtime_root
  for path in "${paths[@]}"; do
    if [[ -e "$path" || -L "$path" ]]; then
      [[ -d "$path" && ! -L "$path" ]] ||
        die "runtime directory must not be a symlink or another file type: $path"
    fi
  done
  mkdir -p "${paths[@]}"
  for path in "${paths[@]}"; do
    chmod 700 "$path"
    require_private_directory "$path"
  done
}

usage() {
  printf '%s\n' \
    'Usage: imessage-proxy ACTION' \
    '' \
    'Actions:' \
    '  doctor' \
    "  bootstrap --config FILE --admin-name NAME [--expires-in-days 30] [--public --confirm 'EXPOSE IMESSAGE PROXY PUBLICLY']" \
    '  prepare' \
    '  build-host' \
    '  check-host' \
    '  api-key bootstrap-admin --name NAME [--expires-in-days 30]' \
    '  server-install' \
    '  server-start' \
    "  server-stop --confirm 'STOP IMESSAGE PROXY SERVER'" \
    "  server-restart --confirm 'RESTART IMESSAGE PROXY SERVER'" \
    '  server-status' \
    "  edge-install --confirm 'EXPOSE IMESSAGE PROXY PUBLICLY'" \
    '  edge-start' \
    '  edge-stop' \
    "  edge-restart --confirm 'RESTART IMESSAGE PROXY EDGE'" \
    '  edge-status' \
    '  edge-logs' \
    '  version' \
    '' \
    'There is no reset, credential-export, or runtime-state removal action.'
}

require_sources() {
  local path
  for path in \
    "$SOURCE_DIR/src/imessage-proxy-server.m" \
    "$SOURCE_DIR/src/api-key-store.m" \
    "$SOURCE_DIR/src/api-key-store.h" \
    "$SOURCE_DIR/config/Caddyfile" \
    "$SOURCE_DIR/config/io.github.mglaeser.imessage-proxy.edge.plist.in" \
    "$SOURCE_DIR/config/io.github.mglaeser.imessage-proxy.plist.in" \
    "$SOURCE_DIR/web/index.html" \
    "$SOURCE_DIR/web/app.js" \
    "$SOURCE_DIR/web/styles.css"; do
    [[ -f "$path" && ! -L "$path" ]] || die "missing required source asset: $path"
  done
}

secure_mode() {
  stat -f '%Lp' "$1"
}

require_private_directory() {
  local mode owner path="$1"
  [[ -d "$path" && ! -L "$path" ]] || die "private directory must be a non-symlink: $path"
  mode="$(secure_mode "$path")"
  [[ "$((8#$mode & 077))" -eq 0 ]] || die "private directory must not be group/world accessible: $path"
  owner="$(stat -f '%Su' "$path")"
  [[ "$owner" == "$(id -un)" ]] || die "private directory must be owned by $(id -un): $path"
}

require_private_file() {
  local links mode owner path="$1"
  [[ -f "$path" && ! -L "$path" ]] || die "private file must be a regular non-symlink: $path"
  links="$(stat -f '%l' "$path")"
  [[ "$links" == 1 ]] || die "private file must have exactly one hard link: $path"
  mode="$(secure_mode "$path")"
  [[ "$((8#$mode & 077))" -eq 0 ]] || die "private file must not be group/world accessible: $path"
  owner="$(stat -f '%Su' "$path")"
  [[ "$owner" == "$(id -un)" ]] || die "private file must be owned by $(id -un): $path"
}

require_private_executable() {
  local label="$2" mode path="$1"
  require_private_file "$path"
  [[ -x "$path" ]] || die "$label must be executable: $path"
  mode="$(secure_mode "$path")"
  [[ "$((8#$mode & 0222))" -eq 0 ]] || die "$label must not be writable: $path"
}

require_launch_agents_directory() {
  local owner path
  for path in "$HOME/Library" "$HOME/Library/LaunchAgents"; do
    if [[ ! -e "$path" && ! -L "$path" ]]; then
      [[ "$path" == "$HOME/Library/LaunchAgents" ]] ||
        die "required macOS user directory is missing: $path"
      mkdir -m 0700 "$path"
    fi
    [[ -d "$path" && ! -L "$path" ]] ||
      die "LaunchAgents path component must be a real directory: $path"
    owner="$(stat -f '%Su' "$path")"
    [[ "$owner" == "$(id -un)" ]] ||
      die "LaunchAgents path component must be owned by $(id -un): $path"
  done
}

require_safe_launch_agent_target() {
  local target="$1"
  require_launch_agents_directory
  if [[ -e "$target" || -L "$target" ]]; then
    require_private_file "$target"
  fi
}

prepare_private_log() {
  local destination="$1" links owner temporary
  if [[ -e "$destination" || -L "$destination" ]]; then
    [[ -f "$destination" && ! -L "$destination" ]] ||
      die "log path must be a regular non-symlink: $destination"
    links="$(stat -f '%l' "$destination")"
    [[ "$links" == 1 ]] || die "log file must have exactly one hard link: $destination"
    owner="$(stat -f '%Su' "$destination")"
    [[ "$owner" == "$(id -un)" ]] || die "log file must be owned by $(id -un): $destination"
  else
    temporary="$(mktemp "$LOG_DIR/log.XXXXXX")"
    chmod 600 "$temporary"
    mv "$temporary" "$destination"
  fi
  chmod 600 "$destination"
  require_private_file "$destination"
}

prepare_edge_log() {
  prepare_private_log "$EDGE_LOG"
}

require_edge_log() {
  require_private_file "$EDGE_LOG"
}

hostname_valid() {
  local LC_ALL=C label name="$1"
  local -a labels
  [[ -n "$name" && "${#name}" -le 253 && "$name" != *[A-Z]* &&
    "$name" == *.* && "$name" != .* && "$name" != *. && "$name" != *..* ]] || return 1
  IFS=. read -r -a labels <<< "$name"
  for label in "${labels[@]}"; do
    [[ "${#label}" -le 63 && "$label" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] || return 1
  done
  [[ ! "$name" =~ ^[0-9.]+$ ]] || return 1
  case "$name" in
    example.com | *.example.com | example.net | *.example.net | example.org | *.example.org | \
      *.example | *.invalid | localhost | *.localhost | *.local | *.internal | \
      *.test | home.arpa | *.home.arpa | onion | *.onion | arpa | *.arpa) return 1 ;;
  esac
}

email_valid() {
  local LC_ALL=C address="$1" domain
  [[ "$address" =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ &&
    "${#address}" -le 254 ]] || return 1
  domain="${address##*@}"
  hostname_valid "$domain"
}

ipv4_address_valid() {
  local LC_ALL=C octet value="$1"
  local -a octets
  [[ "$value" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
  IFS=. read -r -a octets <<< "$value"
  for octet in "${octets[@]}"; do
    [[ "$octet" =~ ^(0|[1-9][0-9]{0,2})$ ]] || return 1
    ((10#$octet <= 255)) || return 1
  done
}

unprivileged_port_valid() {
  local LC_ALL=C
  [[ "$1" =~ ^[1-9][0-9]{3,4}$ ]] && ((10#$1 >= 1024 && 10#$1 <= 65535))
}

service_config_key_allowed() {
  case "$1" in
    IMESSAGE_PROXY_API_HOST | \
      IMESSAGE_PROXY_ACME_EMAIL | \
      IMESSAGE_PROXY_PUBLIC_BIND | \
      IMESSAGE_PROXY_HTTP_PORT | \
      IMESSAGE_PROXY_HTTPS_PORT | \
      IMESSAGE_PROXY_ENABLE_PUBLIC_HTTPS | \
      IMESSAGE_PROXY_IMSG_BIN | \
      IMESSAGE_PROXY_IMSG_SHA256 | \
      IMESSAGE_PROXY_CADDY_BIN | \
      IMESSAGE_PROXY_CADDY_SHA256) return 0 ;;
    *) return 1 ;;
  esac
}

load_service_config() {
  local config_path="$1" expected key line line_number=0 seen='' value
  local -a expected_keys=(
    IMESSAGE_PROXY_API_HOST
    IMESSAGE_PROXY_ACME_EMAIL
    IMESSAGE_PROXY_PUBLIC_BIND
    IMESSAGE_PROXY_HTTP_PORT
    IMESSAGE_PROXY_HTTPS_PORT
    IMESSAGE_PROXY_ENABLE_PUBLIC_HTTPS
    IMESSAGE_PROXY_IMSG_BIN
    IMESSAGE_PROXY_IMSG_SHA256
    IMESSAGE_PROXY_CADDY_BIN
    IMESSAGE_PROXY_CADDY_SHA256
  )
  require_macos
  require_private_file "$config_path"
  while IFS= read -r line || [[ -n "$line" ]]; do
    line_number=$((line_number + 1))
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ "$line" == *=* && "$line" != *$'\r'* ]] ||
      die "service config line $line_number must be one KEY=VALUE assignment"
    key="${line%%=*}"
    value="${line#*=}"
    service_config_key_allowed "$key" ||
      die "service config line $line_number uses an unknown key"
    [[ -n "$value" ]] || die "service config line $line_number has an empty value"
    if [[ $'\n'"$seen" == *$'\n'"$key"$'\n'* ]]; then
      die "service config defines $key more than once"
    fi
    seen+="$key"$'\n'
    export "$key=$value"
  done < "$config_path"
  for expected in "${expected_keys[@]}"; do
    [[ $'\n'"$seen" == *$'\n'"$expected"$'\n'* ]] ||
      die "service config is missing $expected"
  done
}

require_api_settings() {
  local api_host="${IMESSAGE_PROXY_API_HOST:-}"
  local acme_email="${IMESSAGE_PROXY_ACME_EMAIL:-}"
  local bind_ip="${IMESSAGE_PROXY_PUBLIC_BIND:-0.0.0.0}"
  local http_port="${IMESSAGE_PROXY_HTTP_PORT:-8080}"
  local https_port="${IMESSAGE_PROXY_HTTPS_PORT:-8443}"
  hostname_valid "$api_host" ||
    die 'IMESSAGE_PROXY_API_HOST must be an explicit lowercase public DNS hostname'
  email_valid "$acme_email" ||
    die 'IMESSAGE_PROXY_ACME_EMAIL must be a valid operator email address on a public domain'
  unprivileged_port_valid "$http_port" ||
    die 'IMESSAGE_PROXY_HTTP_PORT must be canonical base-10 in the range 1024-65535'
  unprivileged_port_valid "$https_port" ||
    die 'IMESSAGE_PROXY_HTTPS_PORT must be canonical base-10 in the range 1024-65535'
  [[ "$http_port" != "$https_port" ]] ||
    die 'IMESSAGE_PROXY_HTTP_PORT and IMESSAGE_PROXY_HTTPS_PORT must differ'
  if [[ "$bind_ip" != 0.0.0.0 ]]; then
    ipv4_address_valid "$bind_ip" ||
      die 'IMESSAGE_PROXY_PUBLIC_BIND must be 0.0.0.0 or a canonical IPv4 address'
    ifconfig | grep -F "inet $bind_ip " >/dev/null 2>&1 ||
      die "IMESSAGE_PROXY_PUBLIC_BIND $bind_ip is not assigned to this Mac"
  fi
}

require_caddy_source() {
  local actual digest source version_output
  source="${IMESSAGE_PROXY_CADDY_BIN:-$(command -v caddy || true)}"
  digest="${IMESSAGE_PROXY_CADDY_SHA256:-}"
  [[ -n "$source" && -f "$source" && ! -L "$source" && -x "$source" ]] ||
    die 'IMESSAGE_PROXY_CADDY_BIN must name an executable, regular, non-symlink Caddy binary'
  [[ "$digest" =~ ^[0-9a-f]{64}$ ]] ||
    die 'IMESSAGE_PROXY_CADDY_SHA256 must be an independently reviewed SHA-256 digest'
  actual="$(shasum -a 256 "$source" | awk '{print $1}')"
  [[ "$actual" == "$digest" ]] ||
    die 'the configured Caddy binary SHA-256 does not match the reviewed digest'
  version_output="$("$source" version 2>/dev/null)" ||
    die 'the configured Caddy binary did not report a version'
  [[ "${version_output%% *}" == "v$EXPECTED_CADDY_VERSION" ]] ||
    die "expected Caddy $EXPECTED_CADDY_VERSION, found ${version_output%% *}"
  printf '%s\n' "$source"
}

require_imsg_source() {
  local actual digest source version_output
  source="${IMESSAGE_PROXY_IMSG_BIN:-}"
  digest="${IMESSAGE_PROXY_IMSG_SHA256:-}"
  [[ -n "$source" && "$source" == /* && -f "$source" && ! -L "$source" && -x "$source" ]] ||
    die 'IMESSAGE_PROXY_IMSG_BIN must name an absolute executable, regular, non-symlink imsg binary'
  [[ "$digest" =~ ^[0-9a-f]{64}$ ]] ||
    die 'IMESSAGE_PROXY_IMSG_SHA256 must be an independently reviewed SHA-256 digest'
  actual="$(shasum -a 256 "$source" | awk '{print $1}')"
  [[ "$actual" == "$digest" ]] ||
    die 'the configured imsg binary SHA-256 does not match the reviewed digest'
  version_output="$("$source" --version 2>/dev/null)" ||
    die 'the configured imsg binary did not report a version'
  [[ "$version_output" == "$EXPECTED_IMSG_VERSION" ]] ||
    die "expected imsg $EXPECTED_IMSG_VERSION, found ${version_output:-unknown}"
  printf '%s\n' "$source"
}

# The Messages database is Apple-managed state, not something this project
# creates. macOS ships it group/world readable inside a TCC-protected directory,
# so require only that no other account can write it. Demanding 0600 would force
# an operator to weaken their own system just to install this service.
#
# Metadata is checked, never content: reading the database requires Full Disk
# Access, which the native server holds and an ordinary terminal usually does
# not. Prints one status word so doctor can distinguish a definite
# misconfiguration from a state it simply cannot observe.

# Changing a mode under ~/Library/Messages is refused unless the calling
# application holds Full Disk Access, and sudo does not help: TCC attributes the
# request to the responsible application rather than the user ID, so a sudo child
# of the terminal inherits the same refusal. A bare "run chmod" would therefore
# send an operator into a loop that cannot succeed.
print_messages_mode_remedy() {
  local target="$1"
  printf 'FAIL fix it with:  chmod go-w %s\n' "$target" >&2
  printf 'FAIL if that reports "Operation not permitted", macOS is refusing it, not the file mode:\n' >&2
  printf 'FAIL   ls -ldO %s        # a "restricted" flag means macOS owns the path; leave it alone\n' "$target" >&2
  printf 'FAIL   otherwise grant this terminal Full Disk Access, reopen it, and retry the chmod\n' >&2
  printf 'FAIL sudo does not bypass this; TCC follows the application, not the user ID.\n' >&2
}

messages_database_status() {
  local mode owner parent path="$MESSAGES_DATABASE_PATH"
  parent="${path%/*}"
  if [[ -L "$parent" ]]; then
    printf 'symlinked-directory'
    return
  fi
  if [[ ! -d "$parent" ]]; then
    printf 'unavailable'
    return
  fi
  mode="$(secure_mode "$parent" 2>/dev/null)" || {
    printf 'unavailable'
    return
  }
  owner="$(stat -f '%Su' "$parent" 2>/dev/null)" || {
    printf 'unavailable'
    return
  }
  if [[ "$owner" != "$(id -un)" ]]; then
    printf 'foreign-directory'
    return
  fi
  if [[ "$((8#$mode & 022))" -ne 0 ]]; then
    printf 'writable-directory'
    return
  fi
  if [[ -L "$path" ]]; then
    printf 'symlinked-database'
    return
  fi
  if [[ ! -f "$path" ]]; then
    printf 'unavailable'
    return
  fi
  mode="$(secure_mode "$path" 2>/dev/null)" || {
    printf 'unavailable'
    return
  }
  owner="$(stat -f '%Su' "$path" 2>/dev/null)" || {
    printf 'unavailable'
    return
  }
  if [[ "$owner" != "$(id -un)" ]]; then
    printf 'foreign-database'
    return
  fi
  if [[ "$((8#$mode & 022))" -ne 0 ]]; then
    printf 'writable-database'
    return
  fi
  printf 'ok'
}

write_initial_targets() {
  local links owner temporary
  if [[ -e "$TARGETS_FILE" || -L "$TARGETS_FILE" ]]; then
    [[ -f "$TARGETS_FILE" && ! -L "$TARGETS_FILE" ]] ||
      die "target allowlist must be a regular non-symlink: $TARGETS_FILE"
    links="$(stat -f '%l' "$TARGETS_FILE")"
    [[ "$links" == 1 ]] || die 'target allowlist must have exactly one hard link'
    owner="$(stat -f '%Su' "$TARGETS_FILE")"
    [[ "$owner" == "$(id -un)" ]] || die "target allowlist must be owned by $(id -un)"
  else
    temporary="$(mktemp "$PRIVATE/allowed-targets.XXXXXX")"
    {
      printf '%s\n' '# One exact permitted iMessage target per line. An empty file disables sending.'
      printf '%s\n' '# Direct address: canonical +digits or one no-whitespace @ handle'
      printf '%s\n' '# Existing iMessage chat: chat_id:42'
      printf '%s\n' '# Wildcards are not supported.'
    } > "$temporary"
    chmod 600 "$temporary"
    mv "$temporary" "$TARGETS_FILE"
  fi
  chmod 600 "$TARGETS_FILE"
  require_private_file "$TARGETS_FILE"
}

install_prepared_asset() {
  local destination="$2" source="$1" temporary
  [[ -f "$source" && ! -L "$source" ]] || die "invalid source asset: $source"
  [[ ! -L "$destination" ]] || die "refusing destination symlink: $destination"
  temporary="$(mktemp "${destination}.XXXXXX")"
  install -m 0600 "$source" "$temporary"
  mv -f "$temporary" "$destination"
}

stage_caddy_binary() {
  local source temporary version_output
  source="$(require_caddy_source)"
  temporary="$(mktemp "$BIN_DIR/caddy.XXXXXX")"
  install -m 0500 "$source" "$temporary"
  [[ "$(shasum -a 256 "$temporary" | awk '{print $1}')" == "$IMESSAGE_PROXY_CADDY_SHA256" ]] ||
    die 'the staged Caddy binary changed while being copied'
  version_output="$("$temporary" version 2>/dev/null)" ||
    die 'the staged Caddy binary did not report a version'
  [[ "${version_output%% *}" == "v$EXPECTED_CADDY_VERSION" ]] ||
    die "expected Caddy $EXPECTED_CADDY_VERSION, found ${version_output%% *}"
  mv -f "$temporary" "$CADDY_BIN"
}

stage_imsg_binary() {
  local source temporary version_output
  source="$(require_imsg_source)"
  temporary="$(mktemp "$BIN_DIR/imsg.XXXXXX")"
  install -m 0500 "$source" "$temporary"
  [[ "$(shasum -a 256 "$temporary" | awk '{print $1}')" == "$IMESSAGE_PROXY_IMSG_SHA256" ]] ||
    die 'the staged imsg binary changed while being copied'
  version_output="$("$temporary" --version 2>/dev/null)" ||
    die 'the staged imsg binary did not report a version'
  [[ "$version_output" == "$EXPECTED_IMSG_VERSION" ]] ||
    die "expected imsg $EXPECTED_IMSG_VERSION, found ${version_output:-unknown}"
  mv -f "$temporary" "$IMSG_BIN"
}

render_server_agent_to() {
  local destination="$1" public_origin
  public_origin="https://$IMESSAGE_PROXY_API_HOST"
  install -m 0600 "$SOURCE_DIR/config/io.github.mglaeser.imessage-proxy.plist.in" "$destination"
  plutil -replace ProgramArguments.0 -string "$SERVER_BIN" "$destination"
  plutil -replace EnvironmentVariables.IMESSAGE_PROXY_ALLOWED_TARGETS_FILE -string "$TARGETS_FILE" "$destination"
  plutil -replace EnvironmentVariables.IMESSAGE_PROXY_DATABASE_PATH -string "$DATABASE_PATH" "$destination"
  plutil -replace EnvironmentVariables.IMESSAGE_PROXY_EXPECTED_IMSG_VERSION -string "$EXPECTED_IMSG_VERSION" "$destination"
  plutil -replace EnvironmentVariables.IMESSAGE_PROXY_IMSG_BIN -string "$IMSG_BIN" "$destination"
  plutil -replace EnvironmentVariables.IMESSAGE_PROXY_IMSG_SHA256 -string "$IMESSAGE_PROXY_IMSG_SHA256" "$destination"
  plutil -replace EnvironmentVariables.IMESSAGE_PROXY_MESSAGES_DATABASE_PATH -string "$MESSAGES_DATABASE_PATH" "$destination"
  plutil -replace EnvironmentVariables.IMESSAGE_PROXY_PUBLIC_ORIGIN -string "$public_origin" "$destination"
  plutil -replace EnvironmentVariables.IMESSAGE_PROXY_SOCKET_PATH -string "$SOCKET_PATH" "$destination"
  plutil -lint "$destination" >/dev/null
}

render_server_agent() {
  local temporary
  temporary="$(mktemp "$STATE/server-agent.XXXXXX")"
  render_server_agent_to "$temporary"
  mv -f "$temporary" "$SERVER_PLIST_STATE"
  chmod 600 "$SERVER_PLIST_STATE"
}

render_edge_agent_to() {
  local destination="$1"
  install -m 0600 "$SOURCE_DIR/config/io.github.mglaeser.imessage-proxy.edge.plist.in" "$destination"
  plutil -replace ProgramArguments.0 -string "$CADDY_BIN" "$destination"
  plutil -replace ProgramArguments.3 -string "$CADDYFILE" "$destination"
  plutil -replace EnvironmentVariables.IMESSAGE_PROXY_ACME_EMAIL -string "$IMESSAGE_PROXY_ACME_EMAIL" "$destination"
  plutil -replace EnvironmentVariables.IMESSAGE_PROXY_EDGE_LOG_PATH -string "$EDGE_LOG" "$destination"
  plutil -replace EnvironmentVariables.IMESSAGE_PROXY_HTTP_PORT -string "${IMESSAGE_PROXY_HTTP_PORT:-8080}" "$destination"
  plutil -replace EnvironmentVariables.IMESSAGE_PROXY_HTTPS_PORT -string "${IMESSAGE_PROXY_HTTPS_PORT:-8443}" "$destination"
  plutil -replace EnvironmentVariables.IMESSAGE_PROXY_PUBLIC_BIND -string "${IMESSAGE_PROXY_PUBLIC_BIND:-0.0.0.0}" "$destination"
  plutil -replace EnvironmentVariables.IMESSAGE_PROXY_API_HOST -string "$IMESSAGE_PROXY_API_HOST" "$destination"
  plutil -replace EnvironmentVariables.IMESSAGE_PROXY_SOCKET_PATH -string "$SOCKET_PATH" "$destination"
  plutil -replace EnvironmentVariables.IMESSAGE_PROXY_UI_DIR -string "$UI_DIR" "$destination"
  plutil -replace EnvironmentVariables.XDG_CONFIG_HOME -string "$CADDY_CONFIG" "$destination"
  plutil -replace EnvironmentVariables.XDG_DATA_HOME -string "$CADDY_DATA" "$destination"
  plutil -replace WorkingDirectory -string "$CADDY_STATE" "$destination"
  plutil -lint "$destination" >/dev/null
}

render_edge_agent() {
  local temporary
  temporary="$(mktemp "$STATE/edge-agent.XXXXXX")"
  render_edge_agent_to "$temporary"
  mv -f "$temporary" "$EDGE_PLIST_STATE"
  chmod 600 "$EDGE_PLIST_STATE"
}

require_current_server_agent() {
  local status temporary
  require_command plutil
  require_private_file "$SERVER_PLIST_STATE"
  temporary="$(mktemp "$STATE/server-agent-check.XXXXXX")"
  if render_server_agent_to "$temporary" && cmp -s "$temporary" "$SERVER_PLIST_STATE"; then
    status=0
  else
    status=$?
  fi
  rm -f -- "$temporary"
  [[ "$status" -eq 0 ]] ||
    die 'the staged native LaunchAgent does not match current configuration; stop both services and run prepare'
}

require_current_edge_agent() {
  local status temporary
  require_command plutil
  require_private_file "$EDGE_PLIST_STATE"
  temporary="$(mktemp "$STATE/edge-agent-check.XXXXXX")"
  if render_edge_agent_to "$temporary" && cmp -s "$temporary" "$EDGE_PLIST_STATE"; then
    status=0
  else
    status=$?
  fi
  rm -f -- "$temporary"
  [[ "$status" -eq 0 ]] ||
    die 'the staged edge LaunchAgent does not match current configuration; stop both services and run prepare'
}

prepare_ui() {
  local asset
  require_private_directory "$UI_DIR"
  for asset in index.html app.js styles.css; do
    install_prepared_asset "$SOURCE_DIR/web/$asset" "$UI_DIR/$asset"
  done
}

launchctl_snapshot() {
  local diagnostics label="$1" output status
  diagnostics="$(mktemp "${TMPDIR:-/tmp}/imessage-proxy-launchctl.XXXXXX")"
  if output="$(launchctl print "gui/$(id -u)/$label" 2> "$diagnostics")"; then
    status=0
  else
    status=$?
  fi
  case "$status" in
    0)
      [[ -n "$output" && ! -s "$diagnostics" ]] || { rm -f "$diagnostics"; return 2; }
      rm -f "$diagnostics"
      printf '%s\n' "$output"
      ;;
    113)
      if [[ -z "$output" ]] &&
        grep -Eqi 'could not find service|service not found' "$diagnostics"; then
        rm -f "$diagnostics"
        return 1
      fi
      rm -f "$diagnostics"
      return 2
      ;;
    *) rm -f "$diagnostics"; return 2 ;;
  esac
}

service_loaded() {
  launchctl_snapshot "$1" >/dev/null
}

service_running() {
  local snapshot
  snapshot="$(launchctl_snapshot "$1")" || return $?
  grep -Eq '^[[:space:]]*state = running$' <<< "$snapshot"
}

server_loaded() {
  service_loaded "$SERVER_LABEL"
}

edge_loaded() {
  service_loaded "$EDGE_LABEL"
}

service_pid() {
  local label="$1" pid snapshot
  snapshot="$(launchctl_snapshot "$label")" || return $?
  pid="$(sed -n 's/^[[:space:]]*pid = \([1-9][0-9]*\)$/\1/p' <<< "$snapshot")"
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 2
  printf '%s\n' "$pid"
}

listener_owned_by_pid() {
  local bind_ip="$2" names pid="$1" port="$3"
  names="$(lsof -nP -a -p "$pid" -iTCP:"$port" -sTCP:LISTEN -Fn 2>/dev/null)" || return 1
  if [[ "$bind_ip" == 0.0.0.0 ]]; then
    grep -Eq "^n(\\*|0\\.0\\.0\\.0):${port}$" <<< "$names"
  else
    grep -Fqx "n${bind_ip}:${port}" <<< "$names"
  fi
}

server_socket_owned_by_pid() {
  local names pid="$1"
  names="$(lsof -nP -a -p "$pid" -U -Fn 2>/dev/null)" || return 1
  grep -Fqx "n$SOCKET_PATH" <<< "$names"
}

edge_listeners_ready() {
  local bind_ip="${IMESSAGE_PROXY_PUBLIC_BIND:-0.0.0.0}" current_pid pid
  pid="$(service_pid "$EDGE_LABEL")" || return 1
  service_running "$EDGE_LABEL" || return 1
  listener_owned_by_pid "$pid" "$bind_ip" "${IMESSAGE_PROXY_HTTP_PORT:-8080}" || return 1
  listener_owned_by_pid "$pid" "$bind_ip" "${IMESSAGE_PROXY_HTTPS_PORT:-8443}" || return 1
  current_pid="$(service_pid "$EDGE_LABEL")" || return 1
  [[ "$current_pid" == "$pid" ]]
}

edge_http_ready() {
  local bind_ip="${IMESSAGE_PROXY_PUBLIC_BIND:-0.0.0.0}" host="$IMESSAGE_PROXY_API_HOST"
  local http_port="${IMESSAGE_PROXY_HTTP_PORT:-8080}" https_port="${IMESSAGE_PROXY_HTTPS_PORT:-8443}"
  local http_result https_status probe_ip
  probe_ip="$bind_ip"
  [[ "$probe_ip" != 0.0.0.0 ]] || probe_ip=127.0.0.1
  http_result="$(curl --silent --show-error --output /dev/null --noproxy '*' --proto '=http' \
    --connect-timeout 1 --max-time 2 \
    --resolve "$host:$http_port:$probe_ip" \
    --write-out '%{http_code} %{redirect_url}' \
    "http://$host:$http_port/" 2>/dev/null)" || return 1
  [[ "$http_result" == "308 https://$host/" ]] || return 1
  https_status="$(curl --silent --show-error --output /dev/null --noproxy '*' --proto '=https' \
    --connect-timeout 1 --max-time 2 --tlsv1.2 \
    --resolve "$host:$https_port:$probe_ip" \
    --write-out '%{http_code}' \
    "https://$host:$https_port/" 2>/dev/null)" || return 1
  [[ "$https_status" == 200 ]]
}

edge_ready() {
  edge_listeners_ready && edge_http_ready
}

wait_for_edge_ready() {
  local _
  for _ in {1..40}; do
    edge_listeners_ready && break
    sleep 0.25
  done
  edge_listeners_ready || return 1
  for _ in {1..60}; do
    if edge_http_ready; then
      sleep 1
      edge_ready && return 0
    fi
    sleep 1
  done
  return 1
}

wait_for_service_absent() {
  local _ label="$1" status
  for _ in {1..40}; do
    if service_loaded "$label"; then
      sleep 0.25
    else
      status=$?
      [[ "$status" -eq 1 ]] && return 0
      return 1
    fi
  done
  return 1
}

rollback_service_start() {
  local disable_succeeded=yes label="$1" service_absent=yes
  if ! launchctl disable "gui/$(id -u)/$label" >/dev/null 2>&1; then
    disable_succeeded=no
  fi
  launchctl bootout "gui/$(id -u)/$label" >/dev/null 2>&1 || true
  if ! wait_for_service_absent "$label" >/dev/null 2>&1; then
    service_absent=no
  fi
  [[ "$disable_succeeded" == yes && "$service_absent" == yes ]] || return 1
  if [[ "$label" == "$EDGE_LABEL" ]]; then
    edge_ports_free || return 1
  fi
}

rollback_start_or_die() {
  local label="$1"
  rollback_service_start "$label" && return
  if [[ "$label" == "$EDGE_LABEL" ]]; then
    die 'URGENT: automatic public-edge rollback could not confirm containment; disconnect public forwarding and inspect launchctl and lsof immediately'
  fi
  die 'URGENT: automatic native-service rollback could not confirm a disabled and absent LaunchAgent; inspect launchctl immediately'
}

prepare() {
  local status
  require_macos
  require_sources
  require_api_settings
  require_command ifconfig
  require_command launchctl
  require_command plutil
  require_command shasum
  if server_loaded; then
    die 'stop the native server before replacing its staged binary or configuration'
  else
    status=$?
    [[ "$status" -eq 1 ]] || die 'could not determine native LaunchAgent state'
  fi
  if edge_loaded; then
    die 'stop the public edge before replacing its staged binary or configuration'
  else
    status=$?
    [[ "$status" -eq 1 ]] || die 'could not determine public-edge LaunchAgent state'
  fi
  prepare_runtime_directories
  prepare_edge_log
  write_initial_targets
  stage_imsg_binary
  stage_caddy_binary
  install_prepared_asset "$SOURCE_DIR/config/Caddyfile" "$CADDYFILE"
  prepare_ui
  render_server_agent
  render_edge_agent
  printf 'Prepared fresh 1.0 state at %s\n' "$ROOT"
  printf 'Review %s, %s, and %s before starting anything.\n' \
    "$TARGETS_FILE" "$SERVER_PLIST_STATE" "$EDGE_PLIST_STATE"
}

build_host() {
  local clang sdk temporary
  require_macos
  require_sources
  require_safe_runtime_root
  require_command codesign
  require_command xcrun
  require_private_directory "$ROOT"
  require_private_directory "$STATE"
  require_private_directory "$BIN_DIR"
  clang="$(xcrun --find clang)"
  sdk="$(xcrun --sdk macosx --show-sdk-path)"
  [[ -x "$clang" && -d "$sdk" ]] || die 'cannot locate the Apple compiler and macOS SDK'
  temporary="$(mktemp "$BIN_DIR/imessage-proxy-server.XXXXXX")"
  trap 'rm -f "${temporary:-}"' RETURN
  "$clang" -isysroot "$sdk" -fobjc-arc -fblocks -Wall -Wextra -Wpedantic \
    -Wno-gnu-conditional-omitted-operand \
    -Wno-gnu-statement-expression-from-macro-expansion \
    -Werror -O2 \
    "-DIMESSAGE_PROXY_VERSION=\"$VERSION\"" \
    -I "$SOURCE_DIR/src" \
    "$SOURCE_DIR/src/imessage-proxy-server.m" "$SOURCE_DIR/src/api-key-store.m" \
    -framework Foundation -framework Security -lsqlite3 -o "$temporary"
  codesign --force --sign - "$temporary" >/dev/null
  [[ "$("$temporary" version)" == "$VERSION" ]] ||
    die 'built server reported an unexpected version'
  chmod 500 "$temporary"
  mv -f "$temporary" "$SERVER_BIN"
  trap - RETURN
  printf 'Built and ad-hoc signed %s\n' "$SERVER_BIN"
  printf 'Grant Full Disk Access to this exact binary before starting the LaunchAgent.\n'
}

run_server() {
  IMESSAGE_PROXY_ALLOWED_TARGETS_FILE="$TARGETS_FILE" \
    IMESSAGE_PROXY_DATABASE_PATH="$DATABASE_PATH" \
    IMESSAGE_PROXY_EXPECTED_IMSG_VERSION="$EXPECTED_IMSG_VERSION" \
    IMESSAGE_PROXY_IMSG_BIN="$IMSG_BIN" \
    IMESSAGE_PROXY_IMSG_SHA256="$IMESSAGE_PROXY_IMSG_SHA256" \
    IMESSAGE_PROXY_MAX_CONCURRENCY=8 \
    IMESSAGE_PROXY_MESSAGES_DATABASE_PATH="$MESSAGES_DATABASE_PATH" \
    IMESSAGE_PROXY_PUBLIC_ORIGIN="https://${IMESSAGE_PROXY_API_HOST:-invalid.invalid}" \
    IMESSAGE_PROXY_READ_TIMEOUT_SECONDS="$SERVER_READ_TIMEOUT_SECONDS" \
    IMESSAGE_PROXY_SEND_TIMEOUT_SECONDS=180 \
    IMESSAGE_PROXY_SOCKET_PATH="$SOCKET_PATH" \
    IMESSAGE_PROXY_SOCKET_TIMEOUT_SECONDS=10 \
    "$SERVER_BIN" "$@"
}

check_host() {
  require_macos
  require_safe_runtime_root
  require_api_settings
  require_command codesign
  require_command shasum
  require_private_file "$TARGETS_FILE"
  require_private_file "$DATABASE_PATH"
  require_private_executable "$SERVER_BIN" 'native server'
  codesign --verify --strict "$SERVER_BIN" >/dev/null 2>&1 ||
    die 'the native server code signature is invalid'
  [[ "$("$SERVER_BIN" version)" == "$VERSION" ]] ||
    die 'native server version does not match the source release'
  require_staged_imsg
  run_server check-config
}

api_key_bootstrap() {
  local expires_days=30 name=''
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)
        [[ $# -ge 2 ]] || die '--name requires a value'
        name="$2"
        shift 2
        ;;
      --expires-in-days)
        [[ $# -ge 2 ]] || die '--expires-in-days requires a value'
        expires_days="$2"
        shift 2
        ;;
      *) die "unknown bootstrap-admin argument: $1" ;;
    esac
  done
  [[ -n "$name" && "${#name}" -le 80 ]] || die '--name must contain 1-80 characters'
  if ! [[ "$expires_days" =~ ^[1-9][0-9]{0,2}$ ]] || ((10#$expires_days > 365)); then
    die '--expires-in-days must be in the range 1-365'
  fi
  require_macos
  require_safe_runtime_root
  require_api_settings
  require_private_directory "$PRIVATE"
  require_private_file "$TARGETS_FILE"
  [[ -x "$SERVER_BIN" && ! -L "$SERVER_BIN" ]] ||
    die 'run build-host before bootstrapping an administrator'
  run_server bootstrap-admin "$name" "$expires_days"
}

api_key() {
  [[ $# -ge 1 ]] || die 'api-key requires a subcommand'
  case "$1" in
    bootstrap-admin) api_key_bootstrap "$@" ;;
    *) die "unknown api-key subcommand: $1" ;;
  esac
}

initialize_database() {
  require_macos
  require_safe_runtime_root
  require_api_settings
  require_private_directory "$PRIVATE"
  require_private_file "$TARGETS_FILE"
  require_private_executable "$SERVER_BIN" 'native server'
  if [[ -e "$DATABASE_PATH" || -L "$DATABASE_PATH" ]]; then
    require_private_file "$DATABASE_PATH"
  fi
  run_server check-config
  require_private_file "$DATABASE_PATH"
  printf 'Initialized and validated the API-key database without creating a credential.\n'
}

acknowledge_full_disk_access() {
  local acknowledgement=''
  [[ -r /dev/tty && -w /dev/tty ]] ||
    die 'bootstrap needs an interactive terminal for the Full Disk Access checkpoint'
  printf '\nFull Disk Access is the one required manual macOS step.\n' >&2
  printf 'Grant it to this exact freshly built binary:\n  %s\n' "$SERVER_BIN" >&2
  printf 'Keep System Integrity Protection enabled. Do not grant access to Caddy.\n' >&2
  printf "After granting access, type 'FULL DISK ACCESS GRANTED' to continue: " >&2
  IFS= read -r acknowledgement < /dev/tty || die 'could not read the Full Disk Access acknowledgement'
  [[ "$acknowledgement" == 'FULL DISK ACCESS GRANTED' ]] ||
    die 'Full Disk Access acknowledgement did not match; no service or credential was created'
}

require_bootstrap_tty() {
  if ! (exec 9<>/dev/tty) 2>/dev/null; then
    die 'bootstrap needs an interactive controlling terminal before it can change runtime state'
  fi
}

validate_bootstrap_key_arguments() {
  local LC_ALL=C expires_days="$2" name="$1"
  [[ -n "$name" && "${#name}" -le 80 &&
    "$name" != ' '* && "$name" != *' ' && "$name" != *[![:print:]]* ]] ||
    die '--admin-name must contain 1-80 printable ASCII bytes without surrounding spaces'
  if ! [[ "$expires_days" =~ ^[1-9][0-9]{0,2}$ ]] || ((10#$expires_days > 365)); then
    die '--expires-in-days must be in the range 1-365'
  fi
}

check_bootstrap_eligibility() {
  run_server check-bootstrap-admin "$1" "$2"
}

check_messages_read_path() {
  run_server check-messages
}

bootstrap_invoke_self() {
  "$SCRIPT_DIR/imessage-proxy" "$@"
}

bootstrap_failure_rollback() {
  local original_status=$?
  trap - EXIT
  set +e
  printf 'Bootstrap failed after service installation began; containing newly started services.\n' >&2
  if [[ "${bootstrap_edge_may_be_loaded:-no}" == yes ]]; then
    if ! bootstrap_invoke_self edge-stop >&2; then
      printf 'URGENT: bootstrap could not confirm that the public edge is stopped. Disconnect public forwarding and inspect launchctl.\n' >&2
    fi
  fi
  if [[ "${bootstrap_server_may_be_loaded:-no}" == yes ]]; then
    if ! bootstrap_invoke_self server-stop --confirm 'STOP IMESSAGE PROXY SERVER' >&2; then
      printf 'URGENT: bootstrap could not confirm that the native service is stopped. Inspect launchctl and the private socket.\n' >&2
    fi
  fi
  exit "$original_status"
}

bootstrap() {
  local admin_name='' config_path='' confirmation='' expires_days=30 public=no
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --config)
        [[ $# -ge 2 ]] || die '--config requires a path'
        config_path="$2"
        shift 2
        ;;
      --admin-name)
        [[ $# -ge 2 ]] || die '--admin-name requires a value'
        admin_name="$2"
        shift 2
        ;;
      --expires-in-days)
        [[ $# -ge 2 ]] || die '--expires-in-days requires a value'
        expires_days="$2"
        shift 2
        ;;
      --public)
        public=yes
        shift
        ;;
      --confirm)
        [[ $# -ge 2 ]] || die '--confirm requires a value'
        confirmation="$2"
        shift 2
        ;;
      *) die "unknown bootstrap argument: $1" ;;
    esac
  done
  [[ -n "$config_path" ]] || die 'bootstrap requires --config FILE'
  [[ -n "$admin_name" ]] || die 'bootstrap requires --admin-name NAME'
  validate_bootstrap_key_arguments "$admin_name" "$expires_days"
  [[ "$public" == yes || -z "$confirmation" ]] ||
    die '--confirm is accepted only together with --public'
  if [[ "$public" == yes ]]; then
    [[ "$confirmation" == 'EXPOSE IMESSAGE PROXY PUBLICLY' ]] ||
      die "public bootstrap requires --confirm 'EXPOSE IMESSAGE PROXY PUBLICLY'"
  fi

  load_service_config "$config_path"
  if [[ "$public" == yes ]]; then
    [[ "$IMESSAGE_PROXY_ENABLE_PUBLIC_HTTPS" == yes ]] ||
      die 'public bootstrap requires IMESSAGE_PROXY_ENABLE_PUBLIC_HTTPS=yes in the reviewed config'
  else
    [[ "$IMESSAGE_PROXY_ENABLE_PUBLIC_HTTPS" == no ]] ||
      die 'non-public bootstrap requires IMESSAGE_PROXY_ENABLE_PUBLIC_HTTPS=no in the reviewed config'
  fi
  require_bootstrap_tty

  printf 'Running the reviewed iMessage Proxy bootstrap. Progress is sent to stderr; the key is stdout only.\n' >&2
  doctor >&2
  prepare >&2
  build_host >&2
  acknowledge_full_disk_access
  initialize_database >&2
  check_bootstrap_eligibility "$admin_name" "$expires_days" >&2
  check_host >&2
  check_messages_read_path >&2
  bootstrap_server_may_be_loaded=yes
  bootstrap_edge_may_be_loaded=no
  trap bootstrap_failure_rollback EXIT
  server_install >&2
  if [[ "$public" == yes ]]; then
    bootstrap_edge_may_be_loaded=yes
    edge_install 'EXPOSE IMESSAGE PROXY PUBLICLY' >&2
  fi
  printf 'Bootstrap checks passed. Creating the first administrator as the final operation.\n' >&2
  api_key_bootstrap bootstrap-admin --name "$admin_name" --expires-in-days "$expires_days"
  trap - EXIT
  bootstrap_server_may_be_loaded=no
  bootstrap_edge_may_be_loaded=no
}

socket_ready() {
  local status
  [[ -S "$SOCKET_PATH" && ! -L "$SOCKET_PATH" ]] || return 1
  status="$(curl --silent --output /dev/null --write-out '%{http_code}' \
    --connect-timeout 0.5 \
    --max-time 1 \
    --unix-socket "$SOCKET_PATH" \
    http://localhost/api/status 2>/dev/null || true)"
  [[ "$status" == 401 ]]
}

server_ready() {
  local current_pid pid
  pid="$(service_pid "$SERVER_LABEL")" || return 1
  service_running "$SERVER_LABEL" || return 1
  server_socket_owned_by_pid "$pid" || return 1
  socket_ready || return 1
  current_pid="$(service_pid "$SERVER_LABEL")" || return 1
  [[ "$current_pid" == "$pid" ]] || return 1
  service_running "$SERVER_LABEL" || return 1
  server_socket_owned_by_pid "$pid"
}

wait_for_socket() {
  local deadline=$((SECONDS + SERVER_START_TIMEOUT_SECONDS))
  while ((SECONDS < deadline)); do
    server_ready && return 0
    sleep 0.25
  done
  return 1
}

wait_for_socket_absent() {
  local _
  for _ in {1..40}; do
    [[ ! -e "$SOCKET_PATH" && ! -L "$SOCKET_PATH" ]] && return 0
    sleep 0.25
  done
  return 1
}

require_edge_stopped() {
  local status
  if edge_loaded; then
    die 'stop the public edge before changing the native socket owner'
  else
    status=$?
    [[ "$status" -eq 1 ]] || die 'could not determine public-edge LaunchAgent state'
  fi
}

server_install() {
  local status
  require_macos
  require_command curl
  require_command launchctl
  require_command lsof
  require_edge_stopped
  check_host
  require_current_server_agent
  if server_loaded; then
    die "$SERVER_LABEL is already loaded; use server-restart after stopping the edge"
  else
    status=$?
    [[ "$status" -eq 1 ]] || die 'could not determine native LaunchAgent state'
  fi
  require_safe_launch_agent_target "$SERVER_PLIST_TARGET"
  install -m 600 "$SERVER_PLIST_STATE" "$SERVER_PLIST_TARGET"
  launchctl enable "gui/$(id -u)/$SERVER_LABEL"
  if ! launchctl bootstrap "gui/$(id -u)" "$SERVER_PLIST_TARGET"; then
    rollback_start_or_die "$SERVER_LABEL"
    die 'native LaunchAgent bootstrap failed and was disabled again'
  fi
  if ! wait_for_socket; then
    rollback_start_or_die "$SERVER_LABEL"
    wait_for_socket_absent >/dev/null 2>&1 || true
    die 'native LaunchAgent did not become ready and was disabled again'
  fi
  printf 'Loaded %s; the native server is ready on its private Unix socket.\n' "$SERVER_LABEL"
}

server_start() {
  local status
  require_macos
  require_command curl
  require_command launchctl
  require_command lsof
  require_edge_stopped
  check_host
  require_current_server_agent
  require_safe_launch_agent_target "$SERVER_PLIST_TARGET"
  [[ -f "$SERVER_PLIST_TARGET" ]] ||
    die "the installed LaunchAgent is missing; run server-install first: $SERVER_PLIST_TARGET"
  cmp -s "$SERVER_PLIST_STATE" "$SERVER_PLIST_TARGET" ||
    die 'the installed native LaunchAgent is stale; run server-install while it is stopped'
  if server_loaded; then
    server_ready || die 'LaunchAgent is loaded but its Unix socket is not ready or is not owned by its stable PID'
    printf '%s is already loaded and ready.\n' "$SERVER_LABEL"
    return
  else
    status=$?
    [[ "$status" -eq 1 ]] || die 'could not determine native LaunchAgent state'
  fi
  launchctl enable "gui/$(id -u)/$SERVER_LABEL"
  if ! launchctl bootstrap "gui/$(id -u)" "$SERVER_PLIST_TARGET"; then
    rollback_start_or_die "$SERVER_LABEL"
    die 'native LaunchAgent bootstrap failed and was disabled again'
  fi
  if ! wait_for_socket; then
    rollback_start_or_die "$SERVER_LABEL"
    wait_for_socket_absent >/dev/null 2>&1 || true
    die 'native LaunchAgent did not become ready and was disabled again'
  fi
  printf 'Loaded %s; the native server is ready on its private Unix socket.\n' "$SERVER_LABEL"
}

server_stop() {
  local confirmation="$1" status
  [[ "$confirmation" == 'STOP IMESSAGE PROXY SERVER' ]] ||
    die 'server-stop confirmation did not match'
  require_macos
  require_safe_runtime_root
  require_command launchctl
  require_edge_stopped
  if server_loaded; then
    launchctl disable "gui/$(id -u)/$SERVER_LABEL"
    launchctl bootout "gui/$(id -u)/$SERVER_LABEL"
    wait_for_service_absent "$SERVER_LABEL" || die 'native LaunchAgent did not unload cleanly'
    wait_for_socket_absent ||
      die "native LaunchAgent stopped but its socket remains; inspect before continuing: $SOCKET_PATH"
    printf 'Stopped %s. Its installed plist and all runtime state were preserved.\n' "$SERVER_LABEL"
  else
    status=$?
    [[ "$status" -eq 1 ]] || die 'could not determine native LaunchAgent state'
    launchctl disable "gui/$(id -u)/$SERVER_LABEL"
    [[ ! -e "$SOCKET_PATH" && ! -L "$SOCKET_PATH" ]] ||
      die "native LaunchAgent is absent but its socket remains; inspect before continuing: $SOCKET_PATH"
    printf '%s is already stopped.\n' "$SERVER_LABEL"
  fi
}

server_restart() {
  local confirmation="$1"
  [[ "$confirmation" == 'RESTART IMESSAGE PROXY SERVER' ]] ||
    die 'server-restart confirmation did not match'
  require_macos
  require_command curl
  require_command launchctl
  require_command lsof
  require_edge_stopped
  check_host
  require_current_server_agent
  server_loaded || die "$SERVER_LABEL is not loaded"
  require_safe_launch_agent_target "$SERVER_PLIST_TARGET"
  install -m 600 "$SERVER_PLIST_STATE" "$SERVER_PLIST_TARGET"
  launchctl enable "gui/$(id -u)/$SERVER_LABEL"
  if ! launchctl bootout "gui/$(id -u)/$SERVER_LABEL"; then
    launchctl disable "gui/$(id -u)/$SERVER_LABEL" >/dev/null 2>&1 || true
    die 'native LaunchAgent could not be unloaded; its label was disabled for recovery'
  fi
  wait_for_service_absent "$SERVER_LABEL" || die 'native LaunchAgent did not unload cleanly'
  wait_for_socket_absent || die 'the old native Unix socket did not disappear after stop'
  if ! launchctl bootstrap "gui/$(id -u)" "$SERVER_PLIST_TARGET"; then
    rollback_start_or_die "$SERVER_LABEL"
    die 'native LaunchAgent restart bootstrap failed and was disabled again'
  fi
  if ! wait_for_socket; then
    rollback_start_or_die "$SERVER_LABEL"
    wait_for_socket_absent >/dev/null 2>&1 || true
    die 'restarted native LaunchAgent was not ready and was disabled again'
  fi
  printf 'Restarted %s. Start the edge only after validating the new socket.\n' "$SERVER_LABEL"
}

server_status() {
  local snapshot status
  require_macos
  require_safe_runtime_root
  require_command curl
  require_command launchctl
  require_command lsof
  require_api_settings
  require_current_server_agent
  require_safe_launch_agent_target "$SERVER_PLIST_TARGET"
  [[ -f "$SERVER_PLIST_TARGET" ]] ||
    die "the installed native LaunchAgent is missing: $SERVER_PLIST_TARGET"
  cmp -s "$SERVER_PLIST_STATE" "$SERVER_PLIST_TARGET" ||
    die 'the installed native LaunchAgent does not match current staged configuration'
  if snapshot="$(launchctl_snapshot "$SERVER_LABEL")"; then
    printf '%s\n' "$snapshot"
    server_ready || die 'LaunchAgent is loaded but its Unix socket is not ready or is not owned by its stable PID'
  else
    status=$?
    [[ "$status" -eq 1 ]] && die "$SERVER_LABEL is not loaded"
    die 'could not inventory native LaunchAgent state'
  fi
}

require_port_free() {
  local port="$1"
  port_is_free "$port" || die "TCP port $port already has a listener"
}

port_is_free() {
  local port="$1"
  ! lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1
}

edge_ports_free() {
  port_is_free "${IMESSAGE_PROXY_HTTP_PORT:-8080}" &&
    port_is_free "${IMESSAGE_PROXY_HTTPS_PORT:-8443}"
}

require_staged_caddy() {
  local actual version_output
  require_private_executable "$CADDY_BIN" 'staged Caddy binary'
  actual="$(shasum -a 256 "$CADDY_BIN" | awk '{print $1}')"
  [[ "$actual" == "${IMESSAGE_PROXY_CADDY_SHA256:-}" ]] ||
    die 'the staged Caddy binary digest is not the reviewed digest'
  version_output="$("$CADDY_BIN" version 2>/dev/null)" ||
    die 'the staged Caddy binary did not report a version'
  [[ "${version_output%% *}" == "v$EXPECTED_CADDY_VERSION" ]] ||
    die 'the staged Caddy version is not the reviewed version'
}

require_staged_imsg() {
  local actual version_output
  require_private_executable "$IMSG_BIN" 'staged imsg binary'
  [[ "${IMESSAGE_PROXY_IMSG_SHA256:-}" =~ ^[0-9a-f]{64}$ ]] ||
    die 'IMESSAGE_PROXY_IMSG_SHA256 must be the reviewed staged-binary digest'
  actual="$(shasum -a 256 "$IMSG_BIN" | awk '{print $1}')"
  [[ "$actual" == "$IMESSAGE_PROXY_IMSG_SHA256" ]] ||
    die 'the staged imsg binary digest is not the reviewed digest'
  version_output="$("$IMSG_BIN" --version 2>/dev/null)" ||
    die 'the staged imsg binary did not report a version'
  [[ "$version_output" == "$EXPECTED_IMSG_VERSION" ]] ||
    die 'the staged imsg version is not the reviewed version'
}

require_prepared_edge() {
  local asset
  require_safe_runtime_root
  require_staged_caddy
  require_private_file "$CADDYFILE"
  require_edge_log
  require_current_edge_agent
  require_private_directory "$UI_DIR"
  require_private_directory "$CADDY_DATA"
  require_private_directory "$CADDY_CONFIG"
  cmp -s "$SOURCE_DIR/config/Caddyfile" "$CADDYFILE" ||
    die 'prepared Caddyfile is stale; run prepare'
  for asset in index.html app.js styles.css; do
    [[ -f "$UI_DIR/$asset" && ! -L "$UI_DIR/$asset" ]] ||
      die "prepared UI asset is missing: $asset"
    cmp -s "$SOURCE_DIR/web/$asset" "$UI_DIR/$asset" ||
      die "prepared UI asset is stale: $asset"
  done
}

validate_edge_config() {
  IMESSAGE_PROXY_ACME_EMAIL="$IMESSAGE_PROXY_ACME_EMAIL" \
    IMESSAGE_PROXY_EDGE_LOG_PATH="$EDGE_LOG" \
    IMESSAGE_PROXY_HTTP_PORT="${IMESSAGE_PROXY_HTTP_PORT:-8080}" \
    IMESSAGE_PROXY_HTTPS_PORT="${IMESSAGE_PROXY_HTTPS_PORT:-8443}" \
    IMESSAGE_PROXY_PUBLIC_BIND="${IMESSAGE_PROXY_PUBLIC_BIND:-0.0.0.0}" \
    IMESSAGE_PROXY_API_HOST="$IMESSAGE_PROXY_API_HOST" \
    IMESSAGE_PROXY_SOCKET_PATH="$SOCKET_PATH" \
    IMESSAGE_PROXY_UI_DIR="$UI_DIR" \
    XDG_CONFIG_HOME="$CADDY_CONFIG" \
    XDG_DATA_HOME="$CADDY_DATA" \
    "$CADDY_BIN" validate --config "$CADDYFILE" --adapter caddyfile >/dev/null
}

require_public_edge_inputs() {
  require_api_settings
  [[ "${IMESSAGE_PROXY_ENABLE_PUBLIC_HTTPS:-no}" == yes ]] ||
    die 'set IMESSAGE_PROXY_ENABLE_PUBLIC_HTTPS=yes only after completing the public-exposure checklist'
  require_prepared_edge
  require_private_file "$TARGETS_FILE"
  require_private_file "$DATABASE_PATH"
  server_ready || die 'the native LaunchAgent does not own a ready Unix socket; start or repair it first'
  validate_edge_config || die 'the staged public-edge configuration is invalid'
}

edge_install() {
  local confirmation="$1" status
  [[ "$confirmation" == 'EXPOSE IMESSAGE PROXY PUBLICLY' ]] ||
    die 'edge-install confirmation did not match'
  require_macos
  require_command curl
  require_command launchctl
  require_command lsof
  require_command shasum
  require_public_edge_inputs
  if edge_loaded; then
    die "$EDGE_LABEL is already loaded; use edge-restart"
  else
    status=$?
    [[ "$status" -eq 1 ]] || die 'could not determine public-edge LaunchAgent state'
  fi
  require_port_free "${IMESSAGE_PROXY_HTTP_PORT:-8080}"
  require_port_free "${IMESSAGE_PROXY_HTTPS_PORT:-8443}"
  require_safe_launch_agent_target "$EDGE_PLIST_TARGET"
  prepare_edge_log
  install -m 600 "$EDGE_PLIST_STATE" "$EDGE_PLIST_TARGET"
  launchctl enable "gui/$(id -u)/$EDGE_LABEL"
  if ! launchctl bootstrap "gui/$(id -u)" "$EDGE_PLIST_TARGET"; then
    rollback_start_or_die "$EDGE_LABEL"
    die 'public-edge LaunchAgent bootstrap failed and was disabled again'
  fi
  if ! wait_for_edge_ready; then
    rollback_start_or_die "$EDGE_LABEL"
    die 'the public edge did not become ready and was disabled; run edge-logs for bounded diagnostics'
  fi
  printf 'Started the HTTPS edge for https://%s/.\n' "$IMESSAGE_PROXY_API_HOST"
  printf 'External TCP 80/443 must map exactly to host TCP %s/%s before acceptance.\n' \
    "${IMESSAGE_PROXY_HTTP_PORT:-8080}" "${IMESSAGE_PROXY_HTTPS_PORT:-8443}"
}

edge_start() {
  local status
  require_macos
  require_command curl
  require_command launchctl
  require_command lsof
  require_command shasum
  require_public_edge_inputs
  require_safe_launch_agent_target "$EDGE_PLIST_TARGET"
  [[ -f "$EDGE_PLIST_TARGET" ]] ||
    die "the installed edge LaunchAgent is missing; run edge-install first: $EDGE_PLIST_TARGET"
  cmp -s "$EDGE_PLIST_STATE" "$EDGE_PLIST_TARGET" ||
    die 'the installed edge LaunchAgent is stale; run edge-install while it is stopped'
  if edge_loaded; then
    edge_ready || die 'the edge LaunchAgent is loaded but its listeners or HTTPS endpoint are not ready'
    printf '%s is already loaded and ready.\n' "$EDGE_LABEL"
    return
  else
    status=$?
    [[ "$status" -eq 1 ]] || die 'could not determine public-edge LaunchAgent state'
  fi
  require_port_free "${IMESSAGE_PROXY_HTTP_PORT:-8080}"
  require_port_free "${IMESSAGE_PROXY_HTTPS_PORT:-8443}"
  prepare_edge_log
  launchctl enable "gui/$(id -u)/$EDGE_LABEL"
  if ! launchctl bootstrap "gui/$(id -u)" "$EDGE_PLIST_TARGET"; then
    rollback_start_or_die "$EDGE_LABEL"
    die 'public-edge LaunchAgent bootstrap failed and was disabled again'
  fi
  if ! wait_for_edge_ready; then
    rollback_start_or_die "$EDGE_LABEL"
    die 'the public edge did not become ready and was disabled; run edge-logs for bounded diagnostics'
  fi
  printf 'Started %s.\n' "$EDGE_LABEL"
}

edge_stop() {
  local status
  require_macos
  require_safe_runtime_root
  require_command launchctl
  if edge_loaded; then
    launchctl disable "gui/$(id -u)/$EDGE_LABEL"
    launchctl bootout "gui/$(id -u)/$EDGE_LABEL"
    wait_for_service_absent "$EDGE_LABEL" || die 'public-edge LaunchAgent did not unload cleanly'
    printf 'Stopped %s. Certificates, configuration, and all runtime state were preserved.\n' \
      "$EDGE_LABEL"
  else
    status=$?
    [[ "$status" -eq 1 ]] || die 'could not determine public-edge LaunchAgent state'
    launchctl disable "gui/$(id -u)/$EDGE_LABEL"
    printf '%s is already stopped.\n' "$EDGE_LABEL"
  fi
}

edge_restart() {
  local confirmation="$1"
  [[ "$confirmation" == 'RESTART IMESSAGE PROXY EDGE' ]] ||
    die 'edge-restart confirmation did not match'
  require_macos
  require_command curl
  require_command launchctl
  require_command lsof
  require_command shasum
  require_public_edge_inputs
  edge_loaded || die "$EDGE_LABEL is not loaded"
  require_safe_launch_agent_target "$EDGE_PLIST_TARGET"
  prepare_edge_log
  install -m 600 "$EDGE_PLIST_STATE" "$EDGE_PLIST_TARGET"
  launchctl enable "gui/$(id -u)/$EDGE_LABEL"
  if ! launchctl bootout "gui/$(id -u)/$EDGE_LABEL"; then
    launchctl disable "gui/$(id -u)/$EDGE_LABEL" >/dev/null 2>&1 || true
    die 'public-edge LaunchAgent could not be unloaded; its label was disabled for recovery'
  fi
  wait_for_service_absent "$EDGE_LABEL" || die 'public-edge LaunchAgent did not unload cleanly'
  require_port_free "${IMESSAGE_PROXY_HTTP_PORT:-8080}"
  require_port_free "${IMESSAGE_PROXY_HTTPS_PORT:-8443}"
  if ! launchctl bootstrap "gui/$(id -u)" "$EDGE_PLIST_TARGET"; then
    rollback_start_or_die "$EDGE_LABEL"
    die 'public-edge restart bootstrap failed and was disabled again'
  fi
  if ! wait_for_edge_ready; then
    rollback_start_or_die "$EDGE_LABEL"
    die 'the restarted public edge did not become ready and was disabled; run edge-logs for bounded diagnostics'
  fi
  printf 'Restarted %s.\n' "$EDGE_LABEL"
}

edge_status() {
  local snapshot status
  require_macos
  require_command curl
  require_command launchctl
  require_command shasum
  require_api_settings
  require_prepared_edge
  require_safe_launch_agent_target "$EDGE_PLIST_TARGET"
  [[ -f "$EDGE_PLIST_TARGET" ]] ||
    die "the installed edge LaunchAgent is missing: $EDGE_PLIST_TARGET"
  require_edge_log
  cmp -s "$EDGE_PLIST_STATE" "$EDGE_PLIST_TARGET" ||
    die 'the installed edge LaunchAgent does not match current staged configuration'
  validate_edge_config || die 'the staged public-edge configuration is invalid'
  if snapshot="$(launchctl_snapshot "$EDGE_LABEL")"; then
    printf '%s\n' "$snapshot"
    edge_ready || die 'the edge LaunchAgent is loaded but its listeners or HTTPS endpoint are not ready'
  else
    status=$?
    [[ "$status" -eq 1 ]] && die "$EDGE_LABEL is not loaded"
    die 'could not inventory public-edge LaunchAgent state'
  fi
}

edge_logs() {
  require_macos
  require_safe_runtime_root
  require_command tail
  require_edge_log
  printf '%s\n' '--- bounded Caddy runtime log (last 100 lines) ---'
  tail -n 100 "$EDGE_LOG"
}

doctor() {
  local command failed=0
  require_macos
  require_safe_runtime_root
  printf 'iMessage Proxy %s\n' "$VERSION"
  if (require_sources); then
    printf 'OK   source assets: %s\n' "$SOURCE_DIR"
  else
    failed=1
  fi
  for command in awk clang codesign cmp curl ifconfig launchctl lsof plutil sed shasum sqlite3 stat xcrun; do
    if command -v "$command" >/dev/null 2>&1; then
      printf 'OK   command: %s\n' "$command"
    else
      printf 'FAIL command: %s\n' "$command" >&2
      failed=1
    fi
  done
  if (require_imsg_source >/dev/null 2>&1); then
    printf 'OK   imsg %s source binary and SHA-256 pin\n' "$EXPECTED_IMSG_VERSION"
  else
    printf 'FAIL imsg %s source binary or SHA-256 pin\n' "$EXPECTED_IMSG_VERSION" >&2
    failed=1
  fi
  if (require_api_settings); then
    printf 'OK   public hostname, ACME email, bind address, and host ports\n'
  else
    failed=1
  fi
  if (require_caddy_source >/dev/null); then
    printf 'OK   Caddy %s binary and SHA-256 pin\n' "$EXPECTED_CADDY_VERSION"
  else
    failed=1
  fi
  case "${IMESSAGE_PROXY_ENABLE_PUBLIC_HTTPS:-no}" in
    yes) printf 'WARN public-exposure gate is enabled\n' >&2 ;;
    no) printf 'OK   public-exposure gate is disabled\n' ;;
    *)
      printf 'FAIL IMESSAGE_PROXY_ENABLE_PUBLIC_HTTPS must be yes or no\n' >&2
      failed=1
      ;;
  esac
  case "$(messages_database_status)" in
    ok) printf 'OK   Messages database metadata: %s\n' "$MESSAGES_DATABASE_PATH" ;;
    unavailable)
      printf 'WARN Messages database is not visible from this terminal: %s\n' "$MESSAGES_DATABASE_PATH" >&2
      printf 'WARN sign in to Messages, or grant this terminal Full Disk Access to check it here\n' >&2
      ;;
    writable-directory)
      printf 'FAIL another account can write %s\n' "${MESSAGES_DATABASE_PATH%/*}" >&2
      print_messages_mode_remedy "${MESSAGES_DATABASE_PATH%/*}"
      failed=1
      ;;
    writable-database)
      printf 'FAIL another account can write %s\n' "$MESSAGES_DATABASE_PATH" >&2
      print_messages_mode_remedy "$MESSAGES_DATABASE_PATH"
      failed=1
      ;;
    symlinked-directory | symlinked-database)
      printf 'FAIL the Messages database path must not be a symlink: %s\n' "$MESSAGES_DATABASE_PATH" >&2
      failed=1
      ;;
    foreign-directory | foreign-database)
      printf 'FAIL the Messages database must belong to %s: %s\n' "$(id -un)" "$MESSAGES_DATABASE_PATH" >&2
      failed=1
      ;;
  esac
  printf 'INFO state: %s\n' "$ROOT"
  return "$failed"
}

main() {
  [[ $# -ge 1 ]] || { usage; exit 64; }
  case "$1" in
    doctor) [[ $# -eq 1 ]] || die 'doctor takes no arguments'; doctor ;;
    bootstrap) shift; bootstrap "$@" ;;
    prepare) [[ $# -eq 1 ]] || die 'prepare takes no arguments'; prepare ;;
    build-host) [[ $# -eq 1 ]] || die 'build-host takes no arguments'; build_host ;;
    check-host) [[ $# -eq 1 ]] || die 'check-host takes no arguments'; check_host ;;
    api-key) shift; api_key "$@" ;;
    server-install) [[ $# -eq 1 ]] || die 'server-install takes no arguments'; server_install ;;
    server-start) [[ $# -eq 1 ]] || die 'server-start takes no arguments'; server_start ;;
    server-stop)
      [[ $# -eq 3 && "$2" == --confirm ]] || die 'server-stop requires --confirm TEXT'
      server_stop "$3"
      ;;
    server-restart)
      [[ $# -eq 3 && "$2" == --confirm ]] || die 'server-restart requires --confirm TEXT'
      server_restart "$3"
      ;;
    server-status) [[ $# -eq 1 ]] || die 'server-status takes no arguments'; server_status ;;
    edge-install)
      [[ $# -eq 3 && "$2" == --confirm ]] || die 'edge-install requires --confirm TEXT'
      edge_install "$3"
      ;;
    edge-start) [[ $# -eq 1 ]] || die 'edge-start takes no arguments'; edge_start ;;
    edge-stop) [[ $# -eq 1 ]] || die 'edge-stop takes no arguments'; edge_stop ;;
    edge-restart)
      [[ $# -eq 3 && "$2" == --confirm ]] || die 'edge-restart requires --confirm TEXT'
      edge_restart "$3"
      ;;
    edge-status) [[ $# -eq 1 ]] || die 'edge-status takes no arguments'; edge_status ;;
    edge-logs) [[ $# -eq 1 ]] || die 'edge-logs takes no arguments'; edge_logs ;;
    version) [[ $# -eq 1 ]] || die 'version takes no arguments'; printf '%s\n' "$VERSION" ;;
    -h | --help) usage ;;
    *) usage >&2; exit 64 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
