#!/usr/bin/env bash
set -Eeuo pipefail
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin"
export LC_ALL=C
umask 077

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

# A start failure used to end here with no way to see why: the LaunchAgent sent
# both streams to /dev/null. Print the tail of the server log so the reason
# travels with the error instead of requiring a separate log-spelunking session.
# Only the lines this start appended are shown. Nothing truncates the log and it
# survives reinstalls, so an unscoped tail can present an earlier crash loop as
# this start's evidence - the trap report_degraded_start already avoids. "This
# start wrote nothing" is itself a finding: the process never reached its own
# error reporting, which points at launchd or at the readiness checks rather
# than at the server's configuration.
report_server_start_failure() {
  local appended='' offset="${1:-0}"
  if [[ -f "$SERVER_LOG" && ! -L "$SERVER_LOG" ]]; then
    appended="$(tail -c "+$((offset + 1))" "$SERVER_LOG" 2>/dev/null | tail -n 20 || true)"
  fi
  if [[ -n "$appended" ]]; then
    printf 'The native server did not open its socket. What this start wrote to %s:\n' "$SERVER_LOG" >&2
    printf '%s\n' "$appended" >&2
  else
    printf 'The native server did not open its socket and wrote nothing to %s\n' "$SERVER_LOG" >&2
    printf 'during this start. It never reached its own error reporting: either launchd\n' >&2
    printf 'could not run it, or it ran and the readiness checks rejected it.\n' >&2
  fi
  printf 'Full log, including earlier attempts: imessage-proxy server-logs\n' >&2
}

server_log_offset() {
  if [[ -f "$SERVER_LOG" && ! -L "$SERVER_LOG" ]]; then
    stat -f '%z' "$SERVER_LOG"
  else
    printf '0\n'
  fi
}

# A service that answers requests but cannot read Messages is running, not
# healthy. Only the lines this start appended are inspected, so an older warning
# cannot resurface as a false alarm.
report_degraded_start() {
  local appended offset="$1"
  [[ -f "$SERVER_LOG" && ! -L "$SERVER_LOG" ]] || return 0
  appended="$(tail -c "+$((offset + 1))" "$SERVER_LOG" 2>/dev/null || true)"
  [[ "$appended" == *degraded* ]] || return 0
  printf '\nNOTICE: the service is running, but it cannot read Messages.\n' >&2
  printf 'API keys work and GET /api/status reports messages-unavailable.\n' >&2
  printf 'Grant Full Disk Access to this exact binary:\n  %s\n' "$SERVER_BIN" >&2
  printf "Then run: imessage-proxy server-restart --confirm 'RESTART IMESSAGE PROXY SERVER'\n" >&2
  printf 'Details: imessage-proxy server-logs\n' >&2
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command is missing: $1"
}

require_macos() {
  [[ "$(uname -s)" == Darwin ]] || die 'iMessage Proxy runs only on macOS'
  [[ "$EUID" -ne 0 ]] || die 'run iMessage Proxy as the Messages.app user, not root'
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
readonly SCRIPT_DIR
source_dir="${IMESSAGE_PROXY_SOURCE_DIR:-}"
if [[ -z "$source_dir" && -f "$SCRIPT_DIR/../src/imessage-proxy-server.m" ]]; then
  source_dir="$(cd "$SCRIPT_DIR/.." && pwd -P)"
elif [[ -z "$source_dir" && -f "$SCRIPT_DIR/../share/imessage-proxy/src/imessage-proxy-server.m" ]]; then
  source_dir="$(cd "$SCRIPT_DIR/../share/imessage-proxy" && pwd -P)"
fi
readonly SOURCE_DIR="$source_dir"
[[ -n "$SOURCE_DIR" && -f "$SOURCE_DIR/VERSION" ]] ||
  die 'cannot find iMessage Proxy assets; set IMESSAGE_PROXY_SOURCE_DIR'

VERSION="$(< "$SOURCE_DIR/VERSION")"
readonly VERSION
[[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
  die 'VERSION must contain one semantic version'

readonly ROOT="${IMESSAGE_PROXY_HOME:-$HOME/Library/Application Support/iMessage Proxy}"
readonly STATE="$ROOT/state"
readonly PRIVATE="$ROOT/private"
readonly RUN_DIR="$ROOT/run"
readonly LOG_DIR="$STATE/logs"
readonly SERVER_LOG="$LOG_DIR/server.log"
readonly BIN_DIR="$STATE/bin"
readonly SERVER_BIN="$BIN_DIR/imessage-proxy-server"
readonly IMSG_BIN="$BIN_DIR/imsg"
readonly DATABASE_PATH="$PRIVATE/api-keys.sqlite3"
readonly MESSAGES_DATABASE_PATH="$HOME/Library/Messages/chat.db"
readonly TARGETS_FILE="$PRIVATE/allowed-targets.txt"
# The single network setting. Loopback is not configurable: the server binds
# INADDR_LOOPBACK as a compile-time constant and asserts it after listen().
IMESSAGE_PROXY_PORT="${IMESSAGE_PROXY_PORT:-8765}"
readonly UI_DIR="$STATE/ui"
readonly SERVER_LABEL='io.github.mglaeser.imessage-proxy'
readonly SERVER_PLIST_STATE="$STATE/io.github.mglaeser.imessage-proxy.plist"
readonly SERVER_PLIST_TARGET="$HOME/Library/LaunchAgents/io.github.mglaeser.imessage-proxy.plist"
readonly EXPECTED_IMSG_VERSION='0.13.4'
readonly SERVER_READ_TIMEOUT_SECONDS=30
readonly SERVER_START_TIMEOUT_SECONDS=50

require_safe_runtime_root() {
  local ancestor basename
  [[ -n "${HOME:-}" && "$HOME" == /* && "$HOME" != / && "$HOME" != */ &&
    "$HOME" != *//* && "$HOME" != *'/./'* && "$HOME" != */. &&
    "$HOME" != *'/../'* && "$HOME" != */.. ]] ||
    die 'HOME must be a normalized absolute user directory'
  [[ "$ROOT" == "$HOME/"* && "$ROOT" != */ && "$ROOT" != *//* &&
    "$ROOT" != *'/./'* && "$ROOT" != */. && "$ROOT" != *'/../'* && "$ROOT" != */.. ]] ||
    die 'IMESSAGE_PROXY_HOME must be a normalized absolute directory below HOME'
  basename="${ROOT##*/}"
  [[ "$basename" == 'iMessage Proxy' || "$basename" == imessage-proxy ]] ||
    die 'IMESSAGE_PROXY_HOME must end in iMessage Proxy or imessage-proxy'
  [[ -d "$HOME" && ! -L "$HOME" ]] || die 'HOME must be a real directory, not a symlink'

  ancestor="$ROOT"
  while [[ "$ancestor" != "$HOME" ]]; do
    [[ "$ancestor" == "$HOME/"* ]] || die 'runtime path escapes HOME'
    if [[ -e "$ancestor" || -L "$ancestor" ]]; then
      [[ -d "$ancestor" && ! -L "$ancestor" ]] ||
        die "runtime path component must be a real directory: $ancestor"
    fi
    ancestor="${ancestor%/*}"
  done
}

prepare_runtime_directories() {
  local path
  local -a paths=(
    "$ROOT" "$STATE" "$PRIVATE" "$RUN_DIR" "$LOG_DIR" "$BIN_DIR"
    "$UI_DIR"
  )
  require_safe_runtime_root
  for path in "${paths[@]}"; do
    if [[ -e "$path" || -L "$path" ]]; then
      [[ -d "$path" && ! -L "$path" ]] ||
        die "runtime directory must not be a symlink or another file type: $path"
    fi
  done
  mkdir -p "${paths[@]}"
  for path in "${paths[@]}"; do
    chmod 700 "$path"
    require_private_directory "$path"
  done
}

usage() {
  printf '%s\n' \
    'Usage: imessage-proxy ACTION' \
    '' \
    'Actions:' \
    '  doctor' \
    '  bootstrap --config FILE --admin-name NAME [--expires-in-days 30] [--without-admin-key]' \
    '  prepare' \
    '  build-host' \
    '  check-host' \
    '  api-key bootstrap-admin --name NAME [--expires-in-days 30]' \
    '  targets list' \
    '  targets add TARGET' \
    '  targets remove TARGET' \
    '  send-test RECIPIENT' \
    '  enable-messages-read' \
    "  disable-messages-read --confirm 'DISABLE MESSAGES READ'" \
    '  server-install' \
    '  server-start' \
    "  server-stop --confirm 'STOP IMESSAGE PROXY SERVER'" \
    "  server-restart --confirm 'RESTART IMESSAGE PROXY SERVER'" \
    '  server-status' \
    '  server-logs' \
    '  version' \
    '' \
    'Every action except bootstrap reads the reviewed service configuration from' \
    'IMESSAGE_PROXY_CONFIG, default ~/.config/imessage-proxy/service.env. Values' \
    'already present in the environment take precedence over that file.' \
    '' \
    'Reading Messages is switched in that file and carried by the LaunchAgent, so' \
    'a change reaches the service through server-stop, prepare and server-install.' \
    '' \
    'There is no reset, credential-export, or runtime-state removal action.'
}

require_sources() {
  local path
  for path in \
    "$SOURCE_DIR/src/imessage-proxy-server.m" \
    "$SOURCE_DIR/src/api-key-store.m" \
    "$SOURCE_DIR/src/api-key-store.h" \
    "$SOURCE_DIR/config/io.github.mglaeser.imessage-proxy.plist.in" \
    "$SOURCE_DIR/web/index.html" \
    "$SOURCE_DIR/web/app.js" \
    "$SOURCE_DIR/web/styles.css"; do
    [[ -f "$path" && ! -L "$path" ]] || die "missing required source asset: $path"
  done
}

secure_mode() {
  stat -f '%Lp' "$1"
}

require_private_directory() {
  local mode owner path="$1"
  [[ -d "$path" && ! -L "$path" ]] || die "private directory must be a non-symlink: $path"
  mode="$(secure_mode "$path")"
  [[ "$((8#$mode & 077))" -eq 0 ]] || die "private directory must not be group/world accessible: $path"
  owner="$(stat -f '%Su' "$path")"
  [[ "$owner" == "$(id -un)" ]] || die "private directory must be owned by $(id -un): $path"
}

require_private_file() {
  local links mode owner path="$1"
  [[ -f "$path" && ! -L "$path" ]] || die "private file must be a regular non-symlink: $path"
  links="$(stat -f '%l' "$path")"
  [[ "$links" == 1 ]] || die "private file must have exactly one hard link: $path"
  mode="$(secure_mode "$path")"
  [[ "$((8#$mode & 077))" -eq 0 ]] || die "private file must not be group/world accessible: $path"
  owner="$(stat -f '%Su' "$path")"
  [[ "$owner" == "$(id -un)" ]] || die "private file must be owned by $(id -un): $path"
}

require_private_executable() {
  local label="$2" mode path="$1"
  require_private_file "$path"
  [[ -x "$path" ]] || die "$label must be executable: $path"
  mode="$(secure_mode "$path")"
  [[ "$((8#$mode & 0222))" -eq 0 ]] || die "$label must not be writable: $path"
}

require_launch_agents_directory() {
  local owner path
  for path in "$HOME/Library" "$HOME/Library/LaunchAgents"; do
    if [[ ! -e "$path" && ! -L "$path" ]]; then
      [[ "$path" == "$HOME/Library/LaunchAgents" ]] ||
        die "required macOS user directory is missing: $path"
      mkdir -m 0700 "$path"
    fi
    [[ -d "$path" && ! -L "$path" ]] ||
      die "LaunchAgents path component must be a real directory: $path"
    owner="$(stat -f '%Su' "$path")"
    [[ "$owner" == "$(id -un)" ]] ||
      die "LaunchAgents path component must be owned by $(id -un): $path"
  done
}

require_safe_launch_agent_target() {
  local target="$1"
  require_launch_agents_directory
  if [[ -e "$target" || -L "$target" ]]; then
    require_private_file "$target"
  fi
}

prepare_private_log() {
  local destination="$1" links owner temporary
  if [[ -e "$destination" || -L "$destination" ]]; then
    [[ -f "$destination" && ! -L "$destination" ]] ||
      die "log path must be a regular non-symlink: $destination"
    links="$(stat -f '%l' "$destination")"
    [[ "$links" == 1 ]] || die "log file must have exactly one hard link: $destination"
    owner="$(stat -f '%Su' "$destination")"
    [[ "$owner" == "$(id -un)" ]] || die "log file must be owned by $(id -un): $destination"
  else
    temporary="$(mktemp "$LOG_DIR/log.XXXXXX")"
    chmod 600 "$temporary"
    mv "$temporary" "$destination"
  fi
  chmod 600 "$destination"
  require_private_file "$destination"
}

prepare_server_log() {
  prepare_private_log "$SERVER_LOG"
}

require_server_log() {
  require_private_file "$SERVER_LOG"
}


unprivileged_port_valid() {
  local LC_ALL=C
  [[ "$1" =~ ^[1-9][0-9]{3,4}$ ]] && ((10#$1 >= 1024 && 10#$1 <= 65535))
}

# The server reads only the exact word "disabled" as off and treats everything
# else, including a misspelling, as on. A configuration saying "off" or "false"
# would therefore read as off to the person who wrote it and as on to the
# service, so only the two words this CLI writes are accepted.
messages_read_setting_valid() {
  [[ "$1" == enabled || "$1" == disabled ]]
}

# Absent means enabled, exactly as the server reads it, so an installation that
# predates the setting keeps its reads. The default is deliberately not seeded
# into a shell variable at load time: load_service_config fills in only what the
# environment lacks, so a seeded default would outrank the configured value.
messages_read_setting() {
  printf '%s\n' "${IMESSAGE_PROXY_MESSAGES_READ:-enabled}"
}

messages_read_enabled() {
  [[ "$(messages_read_setting)" != disabled ]]
}

service_config_key_allowed() {
  case "$1" in
    IMESSAGE_PROXY_PORT | \
      IMESSAGE_PROXY_MESSAGES_READ | \
      IMESSAGE_PROXY_IMSG_BIN | \
      IMESSAGE_PROXY_IMSG_SHA256) return 0 ;;
    *) return 1 ;;
  esac
}

service_config_path() {
  printf '%s\n' "${IMESSAGE_PROXY_CONFIG:-$HOME/.config/imessage-proxy/service.env}"
}

# Every action except bootstrap used to read the environment and nothing else,
# so a Mac carrying the configuration the installer had just written answered
# a complaint about a setting that had simply never been loaded, for every
# action other than bootstrap. The
# reviewed configuration is now read for those actions too. Values already
# present in the environment win, so an explicit override still works and
# bootstrap's own --config load is untouched.
use_service_config() {
  local path
  path="$(service_config_path)"
  [[ -e "$path" || -L "$path" ]] || return 0
  load_service_config "$path" optional
}

# mode "required" (bootstrap) insists the reviewed configuration is complete and
# takes precedence. mode "optional" fills in only what the environment lacks.
load_service_config() {
  local config_path="$1" expected key line line_number=0 mode="${2:-required}" seen='' value
  local -a expected_keys=(
    IMESSAGE_PROXY_IMSG_BIN
    IMESSAGE_PROXY_IMSG_SHA256
  )
  require_macos
  require_private_file "$config_path"
  while IFS= read -r line || [[ -n "$line" ]]; do
    line_number=$((line_number + 1))
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ "$line" == *=* && "$line" != *$'\r'* ]] ||
      die "service config line $line_number must be one KEY=VALUE assignment"
    key="${line%%=*}"
    value="${line#*=}"
    service_config_key_allowed "$key" ||
      die "service config line $line_number uses an unknown key"
    [[ -n "$value" ]] || die "service config line $line_number has an empty value"
    if [[ $'\n'"$seen" == *$'\n'"$key"$'\n'* ]]; then
      die "service config defines $key more than once"
    fi
    seen+="$key"$'\n'
    if [[ "$mode" == required || -z "${!key:-}" ]]; then
      export "$key=$value"
    fi
  done < "$config_path"
  [[ "$mode" == required ]] || return 0
  for expected in "${expected_keys[@]}"; do
    [[ $'\n'"$seen" == *$'\n'"$expected"$'\n'* ]] ||
      die "service config is missing $expected"
  done
}

# One process, one loopback listener, one network setting. The DNS name, ACME
# contact, bind address, second port and exposure gate all belonged to an edge
# that no longer exists. The Messages-read switch joins it here because a value
# the server would not read as off has to be refused before it is rendered into a
# LaunchAgent, not after a service that was meant to be send-only keeps reading.
require_api_settings() {
  unprivileged_port_valid "$IMESSAGE_PROXY_PORT" ||
    die "IMESSAGE_PROXY_PORT must be canonical base-10 in the range 1024-65535, not: $IMESSAGE_PROXY_PORT"
  messages_read_setting_valid "$(messages_read_setting)" ||
    die "IMESSAGE_PROXY_MESSAGES_READ must be enabled or disabled, not: ${IMESSAGE_PROXY_MESSAGES_READ:-}"
}

# imsg is a payload, not a binary. The executable dlopens a sidecar bridge dylib
# and reads SwiftPM resource bundles from its own directory, and it does neither
# until a send: `--version` and `chats` touch none of them. So an executable
# staged alone reports the right version, passes its digest, lists chats, serves
# a healthy status - and then kills itself with
#   PhoneNumberKit/resource_bundle_accessor.swift: Fatal error: unable to find
#   bundle named PhoneNumberKit_PhoneNumberKit
# on the first send. That shipped. Every guard here was satisfied by a dependency
# that could not send at all.
#
# The members are named rather than globbed so that a future imsg which adds one
# fails at install time instead of at an operator's first send. Presence is not
# loadability - a quarantined, unsigned, or truncated member passes this and
# still traps - which is why the server also reports what the dependency said
# when it dies, rather than only that it died.
IMSG_PAYLOAD_MEMBERS=(
  'imsg-bridge-helper.dylib'
  'PhoneNumberKit_PhoneNumberKit.bundle'
  'SQLite.swift_SQLite.bundle'
)

require_imsg_payload() {
  local directory executable="$1" label="${2:-imsg}" member path
  directory="$(dirname "$executable")"
  for member in "${IMSG_PAYLOAD_MEMBERS[@]}"; do
    path="$directory/$member"
    [[ -e "$path" && ! -L "$path" ]] ||
      die "the $label payload is incomplete: $member is missing from $directory
  imsg reports its version and reads chats without it, and cannot send at all"
    if [[ -d "$path" ]]; then
      [[ -n "$(ls -A "$path" 2>/dev/null)" ]] ||
        die "the $label payload member $member is an empty directory"
    else
      [[ -s "$path" ]] || die "the $label payload member $member is empty"
    fi
  done
}

require_imsg_source() {
  local actual digest source version_output
  source="${IMESSAGE_PROXY_IMSG_BIN:-}"
  digest="${IMESSAGE_PROXY_IMSG_SHA256:-}"
  [[ -n "$source" && "$source" == /* && -f "$source" && ! -L "$source" && -x "$source" ]] ||
    die 'IMESSAGE_PROXY_IMSG_BIN must name an absolute executable, regular, non-symlink imsg binary'
  [[ "$digest" =~ ^[0-9a-f]{64}$ ]] ||
    die 'IMESSAGE_PROXY_IMSG_SHA256 must be an independently reviewed SHA-256 digest'
  actual="$(shasum -a 256 "$source" | awk '{print $1}')"
  [[ "$actual" == "$digest" ]] ||
    die 'the configured imsg binary SHA-256 does not match the reviewed digest'
  # Checked before the binary is executed, not after: an incomplete payload is a
  # property of the file tree and needs no process to observe it.
  require_imsg_payload "$source" 'configured imsg'
  version_output="$("$source" --version 2>/dev/null)" ||
    die 'the configured imsg binary did not report a version'
  [[ "$version_output" == "$EXPECTED_IMSG_VERSION" ]] ||
    die "expected imsg $EXPECTED_IMSG_VERSION, found ${version_output:-unknown}"
  printf '%s\n' "$source"
}

# The Messages database is Apple-managed state, not something this project
# creates. macOS ships it group/world readable inside a TCC-protected directory,
# so require only that no other account can write it. Demanding 0600 would force
# an operator to weaken their own system just to install this service.
#
# Metadata is checked, never content: reading the database requires Full Disk
# Access, which the native server holds and an ordinary terminal usually does
# not. Prints one status word so doctor can distinguish a definite
# misconfiguration from a state it simply cannot observe.

# Reports only whether the Messages database exists and is a plain file this
# user owns. Permissions are deliberately not judged: this project never opens
# the database. It passes the path to the pinned dependency, which reads it under
# its own Full Disk Access grant, and bootstrap proves that path for real with a
# bounded `imsg chats --limit 1`.
messages_database_status() {
  local owner path="$MESSAGES_DATABASE_PATH"
  if [[ -L "$path" ]]; then
    printf 'symlinked'
    return
  fi
  if [[ ! -f "$path" ]]; then
    printf 'missing'
    return
  fi
  owner="$(stat -f '%Su' "$path" 2>/dev/null)" || {
    printf 'unreadable'
    return
  }
  if [[ "$owner" != "$(id -un)" ]]; then
    printf 'foreign'
    return
  fi
  printf 'ok'
}

# Reading off is a decision, not a fault, so both host reports state it as INFO
# rather than as a warning. It explains a whole class of 409s that is otherwise
# visible only through GET /api/status, which needs a key to ask.
report_messages_read_mode() {
  if messages_read_enabled; then
    printf 'INFO reading Messages: enabled\n'
  else
    printf 'INFO reading Messages: disabled; turn it on with: imessage-proxy enable-messages-read\n'
  fi
}

write_initial_targets() {
  local links owner temporary
  if [[ -e "$TARGETS_FILE" || -L "$TARGETS_FILE" ]]; then
    [[ -f "$TARGETS_FILE" && ! -L "$TARGETS_FILE" ]] ||
      die "target allowlist must be a regular non-symlink: $TARGETS_FILE"
    links="$(stat -f '%l' "$TARGETS_FILE")"
    [[ "$links" == 1 ]] || die 'target allowlist must have exactly one hard link'
    owner="$(stat -f '%Su' "$TARGETS_FILE")"
    [[ "$owner" == "$(id -un)" ]] || die "target allowlist must be owned by $(id -un)"
  else
    temporary="$(mktemp "$PRIVATE/allowed-targets.XXXXXX")"
    {
      printf '%s\n' '# One exact permitted iMessage target per line. An empty file disables sending.'
      printf '%s\n' '# Direct address: canonical +digits or one no-whitespace @ handle'
      printf '%s\n' '# Existing iMessage chat: chat_id:42'
      printf '%s\n' '# Wildcards are not supported.'
    } > "$temporary"
    chmod 600 "$temporary"
    mv "$temporary" "$TARGETS_FILE"
  fi
  chmod 600 "$TARGETS_FILE"
  require_private_file "$TARGETS_FILE"
}

install_prepared_asset() {
  local destination="$2" source="$1" temporary
  [[ -f "$source" && ! -L "$source" ]] || die "invalid source asset: $source"
  [[ ! -L "$destination" ]] || die "refusing destination symlink: $destination"
  temporary="$(mktemp "${destination}.XXXXXX")"
  install -m 0600 "$source" "$temporary"
  mv -f "$temporary" "$destination"
}

# The whole payload is staged, not just the executable. Copying the executable
# alone is the defect described above require_imsg_payload: it produced an
# installation that passed every check and could not send.
stage_imsg_binary() {
  local member source source_directory temporary version_output
  source="$(require_imsg_source)"
  source_directory="$(dirname "$source")"
  temporary="$(mktemp "$BIN_DIR/imsg.XXXXXX")"
  install -m 0500 "$source" "$temporary"
  [[ "$(shasum -a 256 "$temporary" | awk '{print $1}')" == "$IMESSAGE_PROXY_IMSG_SHA256" ]] ||
    die 'the staged imsg binary changed while being copied'
  # Members are replaced whole rather than merged, so a member left behind by an
  # earlier version can never sit beside a newer executable. Only the exact
  # names above are ever removed, and only from the runtime bin directory, whose
  # shape require_safe_runtime_root has already established.
  for member in "${IMSG_PAYLOAD_MEMBERS[@]}"; do
    [[ -e "$source_directory/$member" && ! -L "$source_directory/$member" ]] ||
      die "the imsg payload member $member disappeared while staging"
    rm -rf -- "${BIN_DIR:?}/$member"
    cp -R "$source_directory/$member" "${BIN_DIR:?}/$member" ||
      die "could not stage the imsg payload member $member"
  done
  mv -f "$temporary" "$IMSG_BIN"
  # An archive can carry group- or world-readable modes; the runtime keeps its
  # own. Directories need traversal, so X rather than x.
  for member in "${IMSG_PAYLOAD_MEMBERS[@]}"; do
    chmod -R u+rwX,go-rwx "${BIN_DIR:?}/$member" ||
      die "could not secure the staged imsg payload member $member"
  done
  version_output="$("$IMSG_BIN" --version 2>/dev/null)" ||
    die 'the staged imsg binary did not report a version'
  [[ "$version_output" == "$EXPECTED_IMSG_VERSION" ]] ||
    die "expected imsg $EXPECTED_IMSG_VERSION, found ${version_output:-unknown}"
  require_imsg_payload "$IMSG_BIN" 'staged imsg'
}

# "plutil -replace ProgramArguments.0 -string X" is not a replacement on every
# macOS: it can INSERT at that index, leaving the template placeholder in place
# and shifting the real arguments right. A rendered native agent then reads
#   [<server binary>, "__SERVER_BIN__", "serve"]
# which launchd executes happily and the server rejects, printing its usage and
# exiting 64 before it loads any configuration. Build the array from nothing
# instead, so no index semantics are involved: empty it once, then append each
# argument in order.
set_program_arguments() {
  local argument destination="$1"
  shift
  plutil -replace ProgramArguments -json '[]' "$destination"
  for argument; do
    plutil -insert ProgramArguments -string "$argument" -append "$destination"
  done
}

# The rendered ProgramArguments array is the one artifact that decides what
# launchd actually executes, and it was the one artifact nothing checked.
# "plutil -lint" proves only that the result is a well-formed property list: a
# vector that is truncated, padded, or still carrying a placeholder lints,
# compares equal to a second identical render in require_current_*_agent, and
# bootstraps. The service it starts then exits 64 on every spawn, KeepAlive
# relaunches it every ThrottleInterval, and the operator waits out a blind
# readiness timeout. Assert the exact vector here, where the failure is one
# sentence instead of a crash loop.
require_rendered_program_arguments() {
  local actual destination="$1" expected index=0
  shift
  for expected; do
    actual="$(plutil -extract "ProgramArguments.$index" raw -o - "$destination" 2>/dev/null)" ||
      die "rendered LaunchAgent lost argument $index ($expected): $destination"
    [[ "$actual" == "$expected" ]] ||
      die "rendered LaunchAgent argument $index is '$actual', expected '$expected': $destination"
    index=$((index + 1))
  done
  if plutil -extract "ProgramArguments.$index" raw -o - "$destination" >/dev/null 2>&1; then
    die "rendered LaunchAgent has more than $index arguments: $destination"
  fi
}

render_server_agent_to() {
  local destination="$1"
  : "${IMESSAGE_PROXY_PORT:?the service port must be set}"
  install -m 0600 "$SOURCE_DIR/config/io.github.mglaeser.imessage-proxy.plist.in" "$destination"
  set_program_arguments "$destination" "$SERVER_BIN" serve
  plutil -replace EnvironmentVariables.IMESSAGE_PROXY_ALLOWED_TARGETS_FILE -string "$TARGETS_FILE" "$destination"
  plutil -replace EnvironmentVariables.IMESSAGE_PROXY_DATABASE_PATH -string "$DATABASE_PATH" "$destination"
  plutil -replace EnvironmentVariables.IMESSAGE_PROXY_EXPECTED_IMSG_VERSION -string "$EXPECTED_IMSG_VERSION" "$destination"
  plutil -replace EnvironmentVariables.IMESSAGE_PROXY_IMSG_BIN -string "$IMSG_BIN" "$destination"
  plutil -replace EnvironmentVariables.IMESSAGE_PROXY_IMSG_SHA256 -string "$IMESSAGE_PROXY_IMSG_SHA256" "$destination"
  plutil -replace EnvironmentVariables.IMESSAGE_PROXY_MESSAGES_DATABASE_PATH -string "$MESSAGES_DATABASE_PATH" "$destination"
  # Inserted rather than replaced: the template declares no placeholder for this
  # key, and every render starts from a fresh copy of that template, so the key is
  # always absent here. The service decides once, at start, from what this writes.
  plutil -insert EnvironmentVariables.IMESSAGE_PROXY_MESSAGES_READ -string "$(messages_read_setting)" "$destination"
  plutil -replace EnvironmentVariables.IMESSAGE_PROXY_PORT -string "$IMESSAGE_PROXY_PORT" "$destination"
  plutil -replace EnvironmentVariables.IMESSAGE_PROXY_UI_DIR -string "$UI_DIR" "$destination"
  plutil -replace StandardErrorPath -string "$SERVER_LOG" "$destination"
  plutil -replace StandardOutPath -string "$SERVER_LOG" "$destination"
  plutil -lint "$destination" >/dev/null
  require_rendered_program_arguments "$destination" "$SERVER_BIN" serve
}

render_server_agent() {
  local temporary
  temporary="$(mktemp "$STATE/server-agent.XXXXXX")"
  render_server_agent_to "$temporary"
  mv -f "$temporary" "$SERVER_PLIST_STATE"
  chmod 600 "$SERVER_PLIST_STATE"
}

require_current_server_agent() {
  local status temporary
  require_command plutil
  require_private_file "$SERVER_PLIST_STATE"
  temporary="$(mktemp "$STATE/server-agent-check.XXXXXX")"
  if render_server_agent_to "$temporary" && cmp -s "$temporary" "$SERVER_PLIST_STATE"; then
    status=0
  else
    status=$?
  fi
  rm -f -- "$temporary"
  [[ "$status" -eq 0 ]] ||
    die 'the staged native LaunchAgent does not match current configuration; stop both services and run prepare'
}

prepare_ui() {
  local asset
  require_private_directory "$UI_DIR"
  for asset in index.html app.js styles.css; do
    install_prepared_asset "$SOURCE_DIR/web/$asset" "$UI_DIR/$asset"
  done
}

launchctl_snapshot() {
  local diagnostics label="$1" output status
  diagnostics="$(mktemp "${TMPDIR:-/tmp}/imessage-proxy-launchctl.XXXXXX")"
  if output="$(launchctl print "gui/$(id -u)/$label" 2> "$diagnostics")"; then
    status=0
  else
    status=$?
  fi
  case "$status" in
    0)
      [[ -n "$output" && ! -s "$diagnostics" ]] || { rm -f "$diagnostics"; return 2; }
      rm -f "$diagnostics"
      printf '%s\n' "$output"
      ;;
    113)
      if [[ -z "$output" ]] &&
        grep -Eqi 'could not find service|service not found' "$diagnostics"; then
        rm -f "$diagnostics"
        return 1
      fi
      rm -f "$diagnostics"
      return 2
      ;;
    *) rm -f "$diagnostics"; return 2 ;;
  esac
}

service_loaded() {
  launchctl_snapshot "$1" >/dev/null
}

service_running() {
  local snapshot
  snapshot="$(launchctl_snapshot "$1")" || return $?
  grep -Eq '^[[:space:]]*state = running$' <<< "$snapshot"
}

server_loaded() {
  service_loaded "$SERVER_LABEL"
}

service_pid() {
  local label="$1" pid snapshot
  snapshot="$(launchctl_snapshot "$label")" || return $?
  pid="$(sed -n 's/^[[:space:]]*pid = \([1-9][0-9]*\)$/\1/p' <<< "$snapshot")"
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 2
  printf '%s\n' "$pid"
}

listener_owned_by_pid() {
  local bind_ip="$2" names pid="$1" port="$3"
  names="$(lsof -nP -a -p "$pid" -iTCP:"$port" -sTCP:LISTEN -Fn 2>/dev/null)" || return 1
  if [[ "$bind_ip" == 0.0.0.0 ]]; then
    grep -Eq "^n(\\*|0\\.0\\.0\\.0):${port}$" <<< "$names"
  else
    grep -Fqx "n${bind_ip}:${port}" <<< "$names"
  fi
}

# Asserts both that the listener belongs to the agent's own process and that it
# is bound to loopback specifically. A wildcard bind would not match 127.0.0.1
# exactly, so an accidentally exposed listener fails readiness rather than being
# reported healthy.
server_socket_owned_by_pid() {
  listener_owned_by_pid "$1" 127.0.0.1 "$IMESSAGE_PROXY_PORT"
}

wait_for_service_absent() {
  local _ label="$1" status
  for _ in {1..40}; do
    if service_loaded "$label"; then
      sleep 0.25
    else
      status=$?
      [[ "$status" -eq 1 ]] && return 0
      return 1
    fi
  done
  return 1
}

rollback_service_start() {
  local disable_succeeded=yes label="$1" service_absent=yes
  if ! launchctl disable "gui/$(id -u)/$label" >/dev/null 2>&1; then
    disable_succeeded=no
  fi
  launchctl bootout "gui/$(id -u)/$label" >/dev/null 2>&1 || true
  if ! wait_for_service_absent "$label" >/dev/null 2>&1; then
    service_absent=no
  fi
  [[ "$disable_succeeded" == yes && "$service_absent" == yes ]] || return 1
}

rollback_start_or_die() {
  local label="$1"
  rollback_service_start "$label" && return
  die 'URGENT: automatic native-service rollback could not confirm a disabled and absent LaunchAgent; inspect launchctl immediately'
}

prepare() {
  local status
  require_macos
  require_sources
  require_api_settings
  require_command ifconfig
  require_command launchctl
  require_command plutil
  require_command shasum
  if server_loaded; then
    die 'stop the native server before replacing its staged binary or configuration'
  else
    status=$?
    [[ "$status" -eq 1 ]] || die 'could not determine native LaunchAgent state'
  fi
  prepare_runtime_directories
  prepare_server_log
  write_initial_targets
  stage_imsg_binary
  prepare_ui
  render_server_agent
  printf 'Prepared fresh 1.0 state at %s\n' "$ROOT"
  printf 'Review %s and %s before starting anything.\n' \
    "$TARGETS_FILE" "$SERVER_PLIST_STATE"
}

build_host() {
  local clang sdk temporary
  require_macos
  require_sources
  require_safe_runtime_root
  require_command codesign
  require_command xcrun
  require_private_directory "$ROOT"
  require_private_directory "$STATE"
  require_private_directory "$BIN_DIR"
  clang="$(xcrun --find clang)"
  sdk="$(xcrun --sdk macosx --show-sdk-path)"
  [[ -x "$clang" && -d "$sdk" ]] || die 'cannot locate the Apple compiler and macOS SDK'
  temporary="$(mktemp "$BIN_DIR/imessage-proxy-server.XXXXXX")"
  trap 'rm -f "${temporary:-}"' RETURN
  "$clang" -isysroot "$sdk" -fobjc-arc -fblocks -Wall -Wextra -Wpedantic \
    -Wno-gnu-conditional-omitted-operand \
    -Wno-gnu-statement-expression-from-macro-expansion \
    -Werror -O2 \
    "-DIMESSAGE_PROXY_VERSION=\"$VERSION\"" \
    -I "$SOURCE_DIR/src" \
    "$SOURCE_DIR/src/imessage-proxy-server.m" "$SOURCE_DIR/src/api-key-store.m" \
    -framework Foundation -framework Security -lsqlite3 -o "$temporary"
  codesign --force --sign - "$temporary" >/dev/null
  [[ "$("$temporary" version)" == "$VERSION" ]] ||
    die 'built server reported an unexpected version'
  chmod 500 "$temporary"
  mv -f "$temporary" "$SERVER_BIN"
  trap - RETURN
  printf 'Built and ad-hoc signed %s\n' "$SERVER_BIN"
  printf 'Grant Full Disk Access to this exact binary before starting the LaunchAgent.\n'
}

run_server() {
  IMESSAGE_PROXY_ALLOWED_TARGETS_FILE="$TARGETS_FILE" \
    IMESSAGE_PROXY_DATABASE_PATH="$DATABASE_PATH" \
    IMESSAGE_PROXY_EXPECTED_IMSG_VERSION="$EXPECTED_IMSG_VERSION" \
    IMESSAGE_PROXY_IMSG_BIN="$IMSG_BIN" \
    IMESSAGE_PROXY_IMSG_SHA256="$IMESSAGE_PROXY_IMSG_SHA256" \
    IMESSAGE_PROXY_MAX_CONCURRENCY=8 \
    IMESSAGE_PROXY_MESSAGES_DATABASE_PATH="$MESSAGES_DATABASE_PATH" \
    IMESSAGE_PROXY_MESSAGES_READ="$(messages_read_setting)" \
    IMESSAGE_PROXY_PORT="$IMESSAGE_PROXY_PORT" \
    IMESSAGE_PROXY_READ_TIMEOUT_SECONDS="$SERVER_READ_TIMEOUT_SECONDS" \
    IMESSAGE_PROXY_SEND_TIMEOUT_SECONDS=180 \
    IMESSAGE_PROXY_SOCKET_TIMEOUT_SECONDS=10 \
    IMESSAGE_PROXY_UI_DIR="$UI_DIR" \
    "$SERVER_BIN" "$@"
}

check_host() {
  require_macos
  require_safe_runtime_root
  require_api_settings
  require_command codesign
  require_command shasum
  require_private_file "$TARGETS_FILE"
  require_private_file "$DATABASE_PATH"
  require_private_executable "$SERVER_BIN" 'native server'
  codesign --verify --strict "$SERVER_BIN" >/dev/null 2>&1 ||
    die 'the native server code signature is invalid'
  [[ "$("$SERVER_BIN" version)" == "$VERSION" ]] ||
    die 'native server version does not match the source release'
  require_staged_imsg
  report_messages_read_mode
  run_server check-config
}

api_key_bootstrap() {
  local expires_days=30 name=''
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)
        [[ $# -ge 2 ]] || die '--name requires a value'
        name="$2"
        shift 2
        ;;
      --expires-in-days)
        [[ $# -ge 2 ]] || die '--expires-in-days requires a value'
        expires_days="$2"
        shift 2
        ;;
      *) die "unknown bootstrap-admin argument: $1" ;;
    esac
  done
  [[ -n "$name" && "${#name}" -le 80 ]] || die '--name must contain 1-80 characters'
  if ! [[ "$expires_days" =~ ^[1-9][0-9]{0,3}$ ]] || ((10#$expires_days > 1461)); then
    die '--expires-in-days must be in the range 1-1461'
  fi
  require_macos
  require_safe_runtime_root
  require_api_settings
  require_private_directory "$PRIVATE"
  require_private_file "$TARGETS_FILE"
  [[ -x "$SERVER_BIN" && ! -L "$SERVER_BIN" ]] ||
    die 'run build-host before bootstrapping an administrator'
  run_server bootstrap-admin "$name" "$expires_days"
}

# The allowlist decides who this machine may message, so it is the one setting
# no API key of any scope should be able to widen from the outside without the
# operator's own account. The CLI therefore edits the file directly as the Mac
# user who owns it, and the API exposes the same list only to an admin key. The
# server re-reads the file on every send, so a change here takes effect at once
# and no restart is needed.
#
# These rules must stay identical to IsDirectMessageRecipient/ParseAllowedTargets
# in src/imessage-proxy-server.m: a target this accepts has to be a target a send
# accepts, or the CLI would happily write a file the server then rejects whole.
target_is_valid() {
  local value="$1" digits
  case "$value" in
    chat_id:*)
      digits="${value#chat_id:}"
      [[ "$digits" =~ ^[1-9][0-9]{0,17}$ ]]
      return
      ;;
    '' | -* | *[[:space:]]* | *[[:cntrl:]]*) return 1 ;;
  esac
  [[ "${#value}" -le 256 ]] || return 1
  if [[ "$value" == +* ]]; then
    digits="${value#+}"
    [[ "$digits" =~ ^[1-9][0-9]{6,14}$ ]] && return 0
  fi
  # Exactly one @, neither first nor last.
  [[ "$value" == *@* && "$value" != @* && "$value" != *@ && "$value" != *@*@* ]]
}

# Prints one target per line. A file that cannot be read safely is an error, not
# an empty list: treating it as empty would let `add` overwrite a file this
# process was never allowed to read.
read_targets() {
  [[ -e "$TARGETS_FILE" || -L "$TARGETS_FILE" ]] ||
    die "the recipient allowlist is missing: $TARGETS_FILE
  reinstall, or recreate it with: imessage-proxy targets add TARGET"
  require_private_file "$TARGETS_FILE"
  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" || "$line" == '#'* ]] && continue
    printf '%s\n' "$line"
  done < "$TARGETS_FILE"
}

# Written whole through a temporary and renamed, so a send that reads the file
# concurrently never sees a partial list.
write_targets() {
  local temporary
  temporary="$(mktemp "$PRIVATE/allowed-targets.XXXXXX")"
  {
    printf '%s\n' '# One exact permitted iMessage target per line. An empty file disables sending.'
    printf '%s\n' '# Direct address: canonical +digits or one no-whitespace @ handle'
    printf '%s\n' '# Existing iMessage chat: chat_id:42'
    printf '%s\n' '# Wildcards are not supported.'
    [[ $# -eq 0 ]] || printf '%s\n' "$@"
  } > "$temporary"
  chmod 600 "$temporary"
  mv "$temporary" "$TARGETS_FILE"
  require_private_file "$TARGETS_FILE"
}
# Sends one message through the pinned dependency, directly rather than through
# the API. That is deliberate: this exists to raise the macOS Apple Events prompt
# at a moment the operator is expecting it, and to prove the dependency, its
# payload and the Messages grant all work. It does not exercise the HTTP layer,
# which readiness already proved before this ever runs.
send_test() {
  local target="${1:-}"
  require_macos
  require_safe_runtime_root
  [[ -n "$target" ]] || die 'send-test requires one recipient'
  target_is_valid "$target" ||
    die "not a valid recipient: $target
  use +digits (7-15, no leading zero) or one handle containing a single @"
  require_staged_imsg
  printf 'Sending a test message to %s.\n' "$target"
  printf 'macOS asks once to allow control of Messages; approve it.\n'
  if ! "$IMSG_BIN" send --to "$target" \
    --text 'iMessage Proxy is set up. This is its test message.' \
    --service imessage --no-sms-fallback \
    --db "$MESSAGES_DATABASE_PATH" --json > /dev/null 2>&1; then
    die "the test message could not be sent
  Approve the Messages prompt, then run: imessage-proxy send-test $target
  If no prompt appeared, check System Settings > Privacy & Security > Automation"
  fi
  printf 'Sent. Check your messages.\n'
}

# Written whole through a temporary and renamed, like every other file this CLI
# owns, so an action reading the configuration concurrently never sees half of
# it. An existing assignment is dropped rather than edited in place, because
# load_service_config refuses a file that defines the same key twice.
write_messages_read_setting() {
  local line path="$1" setting="$2" temporary
  temporary="$(mktemp "$path.XXXXXX")"
  {
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ "$line" == IMESSAGE_PROXY_MESSAGES_READ=* ]] && continue
      printf '%s\n' "$line"
    done < "$path"
    printf 'IMESSAGE_PROXY_MESSAGES_READ=%s\n' "$setting"
  } > "$temporary"
  chmod 600 "$temporary"
  mv "$temporary" "$path"
  require_private_file "$path"
}

# The service reads this once, when it starts, from the environment its
# LaunchAgent hands it, and only prepare renders that plist again. server-restart
# reinstalls the staged copy unchanged, so it cannot carry a setting that copy
# does not already have: an operator told to restart would watch the old mode
# survive and conclude the setting does nothing.
report_messages_read_apply_steps() {
  printf '%s\n' \
    'The LaunchAgent carries this setting. server-restart reuses the installed' \
    'plist, so it does not apply a change; prepare renders it and server-install' \
    'installs it:' \
    "  imessage-proxy server-stop --confirm 'STOP IMESSAGE PROXY SERVER'" \
    '  imessage-proxy prepare' \
    '  imessage-proxy server-install'
}

# The switch has to outlive the shell that set it, so it is stored in the
# reviewed configuration every action already loads rather than exported once.
set_messages_read() {
  local path setting="$1"
  require_macos
  require_safe_runtime_root
  path="$(service_config_path)"
  [[ -e "$path" || -L "$path" ]] ||
    die "the reviewed service configuration is missing: $path
  reinstall, or point IMESSAGE_PROXY_CONFIG at the file this installation uses"
  require_private_file "$path"
  write_messages_read_setting "$path" "$setting"
  printf 'Reading Messages is %s in %s\n' "$setting" "$path"
}

enable_messages_read() {
  set_messages_read enabled
  # Full Disk Access is the one macOS permission that is never prompted for, so
  # turning the switch on is only half of it: an ungranted read fails silently
  # from the service's side and shows up as 503 messages-unavailable.
  printf 'Reading also needs Full Disk Access, which this does not grant. Add this exact binary\n'
  printf 'in System Settings > Privacy & Security > Full Disk Access:\n  %s\n' "$SERVER_BIN"
  report_messages_read_apply_steps
}

disable_messages_read() {
  local confirmation="$1"
  [[ "$confirmation" == 'DISABLE MESSAGES READ' ]] ||
    die 'disable-messages-read confirmation did not match'
  set_messages_read disabled
  printf 'Sending is unaffected on both transports. Every route that answers out of the\n'
  printf 'Messages database, and a send addressed to a chat_id, refuses with\n'
  printf '409 messages-read-disabled.\n'
  report_messages_read_apply_steps
}

targets() {
  local action="${1:-list}" existing listed target
  local -a current=()
  require_macos
  require_safe_runtime_root
  # Read once, up front, through a command substitution: a failure inside
  # read_targets stops the action here instead of arriving as an empty list.
  listed="$(read_targets)" || exit 1
  case "$action" in
    list)
      [[ $# -eq 1 ]] || die 'targets list takes no arguments'
      if [[ -z "$listed" ]]; then
        printf 'No targets are allowed, so sending is disabled.\n'
        printf 'Allow one with: imessage-proxy targets add TARGET\n'
      else
        printf '%s\n' "$listed"
      fi
      ;;
    add)
      [[ $# -eq 2 ]] || die 'targets add requires exactly one target'
      target="$2"
      target_is_valid "$target" ||
        die "not a valid target: $target
  use +digits (7-15, no leading zero), one handle containing a single @, or chat_id:N"
      if [[ -n "$listed" ]]; then
        while IFS= read -r existing; do
          [[ "$existing" == "$target" ]] && die "already allowed: $target"
          current+=("$existing")
        done <<< "$listed"
      fi
      current+=("$target")
      write_targets "${current[@]}"
      printf 'Allowed %s. It can be messaged immediately; no restart is needed.\n' "$target"
      ;;
    remove)
      [[ $# -eq 2 ]] || die 'targets remove requires exactly one target'
      target="$2"
      local found=no
      if [[ -n "$listed" ]]; then
        while IFS= read -r existing; do
          if [[ "$existing" == "$target" ]]; then
            found=yes
            continue
          fi
          current+=("$existing")
        done <<< "$listed"
      fi
      [[ "$found" == yes ]] || die "not currently allowed: $target"
      write_targets ${current[@]+"${current[@]}"}
      printf 'Removed %s. It can no longer be messaged.\n' "$target"
      ;;
    *) die "unknown targets subcommand: $action" ;;
  esac
}

api_key() {
  [[ $# -ge 1 ]] || die 'api-key requires a subcommand'
  case "$1" in
    bootstrap-admin) api_key_bootstrap "$@" ;;
    *) die "unknown api-key subcommand: $1" ;;
  esac
}

initialize_database() {
  require_macos
  require_safe_runtime_root
  require_api_settings
  require_private_directory "$PRIVATE"
  require_private_file "$TARGETS_FILE"
  require_private_executable "$SERVER_BIN" 'native server'
  if [[ -e "$DATABASE_PATH" || -L "$DATABASE_PATH" ]]; then
    require_private_file "$DATABASE_PATH"
  fi
  run_server check-config
  require_private_file "$DATABASE_PATH"
  printf 'Initialized and validated the API-key database without creating a credential.\n'
}

# Split from the prompt loop so the matching rule can be tested without a tty.


require_bootstrap_tty() {
  if ! (exec 9<>/dev/tty) 2>/dev/null; then
    die 'bootstrap needs an interactive controlling terminal before it can change runtime state'
  fi
}

validate_bootstrap_key_arguments() {
  local LC_ALL=C expires_days="$2" name="$1"
  [[ -n "$name" && "${#name}" -le 80 &&
    "$name" != ' '* && "$name" != *' ' && "$name" != *[![:print:]]* ]] ||
    die '--admin-name must contain 1-80 printable ASCII bytes without surrounding spaces'
  if ! [[ "$expires_days" =~ ^[1-9][0-9]{0,3}$ ]] || ((10#$expires_days > 1461)); then
    die '--expires-in-days must be in the range 1-1461'
  fi
}

check_bootstrap_eligibility() {
  run_server check-bootstrap-admin "$1" "$2"
}

bootstrap_invoke_self() {
  "$SCRIPT_DIR/imessage-proxy" "$@"
}

bootstrap_failure_rollback() {
  local original_status=$?
  trap - EXIT
  set +e
  printf 'Bootstrap failed after service installation began; containing newly started services.\n' >&2
  if [[ "${bootstrap_server_may_be_loaded:-no}" == yes ]]; then
    if ! bootstrap_invoke_self server-stop --confirm 'STOP IMESSAGE PROXY SERVER' >&2; then
      printf 'URGENT: bootstrap could not confirm that the native service is stopped. Inspect launchctl and the private socket.\n' >&2
    fi
  fi
  exit "$original_status"
}

bootstrap() {
  local admin_name='' config_path='' create_admin_key=yes expires_days=30 require_terminal=yes
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --config)
        [[ $# -ge 2 ]] || die '--config requires a path'
        config_path="$2"
        shift 2
        ;;
      --admin-name)
        [[ $# -ge 2 ]] || die '--admin-name requires a value'
        admin_name="$2"
        shift 2
        ;;
      --expires-in-days)
        [[ $# -ge 2 ]] || die '--expires-in-days requires a value'
        expires_days="$2"
        shift 2
        ;;
      --without-admin-key)
        create_admin_key=no
        shift
        ;;
      --unattended)
        require_terminal=no
        shift
        ;;
      *) die "unknown bootstrap argument: $1" ;;
    esac
  done
  [[ -n "$config_path" ]] || die 'bootstrap requires --config FILE'
  [[ -n "$admin_name" ]] || die 'bootstrap requires --admin-name NAME'
  validate_bootstrap_key_arguments "$admin_name" "$expires_days"
  load_service_config "$config_path"
  # The terminal gate stops an automated context changing runtime state by
  # accident. An install that answered every question on the command line is the
  # opposite of an accident, so it waives the gate explicitly rather than the
  # gate guessing from whether a tty happens to exist - `ssh mac 'curl ... |
  # bash'` has no controlling terminal, and that is the shape of an unattended
  # install rather than a reason to refuse one.
  [[ "$require_terminal" == no ]] || require_bootstrap_tty

  printf 'Running the reviewed iMessage Proxy bootstrap. Progress is sent to stderr; the key is stdout only.\n' >&2
  doctor >&2
  prepare >&2
  build_host >&2
  initialize_database >&2
  check_bootstrap_eligibility "$admin_name" "$expires_days" >&2
  check_host >&2
  bootstrap_server_may_be_loaded=yes
  trap bootstrap_failure_rollback EXIT
  server_install >&2
  if [[ "$create_admin_key" == yes ]]; then
    printf 'Bootstrap checks passed. Creating the first administrator as the final operation.\n' >&2
    api_key_bootstrap bootstrap-admin --name "$admin_name" --expires-in-days "$expires_days"
  else
    # The installer creates the key itself, after its summary, so the key is the
    # last line on screen and still the only byte on stdout.
    printf 'Bootstrap checks passed. No administrator key was created.\n' >&2
  fi
  trap - EXIT
  bootstrap_server_may_be_loaded=no
}

# Readiness is still "answers 401 on /api/status", which proves the process
# parsed a request and consulted its key store. Only the transport changed.
socket_ready() {
  local status
  status="$(curl --silent --output /dev/null --write-out '%{http_code}' \
    --connect-timeout 0.5 \
    --max-time 1 \
    "http://127.0.0.1:$IMESSAGE_PROXY_PORT/api/status" 2>/dev/null || true)"
  [[ "$status" == 401 ]]
}

server_ready() {
  local current_pid pid
  pid="$(service_pid "$SERVER_LABEL")" || return 1
  service_running "$SERVER_LABEL" || return 1
  server_socket_owned_by_pid "$pid" || return 1
  socket_ready || return 1
  current_pid="$(service_pid "$SERVER_LABEL")" || return 1
  [[ "$current_pid" == "$pid" ]] || return 1
  service_running "$SERVER_LABEL" || return 1
  server_socket_owned_by_pid "$pid"
}

wait_for_socket() {
  local deadline=$((SECONDS + SERVER_START_TIMEOUT_SECONDS))
  while ((SECONDS < deadline)); do
    server_ready && return 0
    sleep 0.25
  done
  return 1
}

# A TCP listener leaves no filesystem artifact, so "gone" means nothing is
# listening on the port any more.
server_port_free() {
  ! lsof -nP -iTCP:"$IMESSAGE_PROXY_PORT" -sTCP:LISTEN >/dev/null 2>&1
}

wait_for_socket_absent() {
  local _
  for _ in {1..40}; do
    server_port_free && return 0
    sleep 0.25
  done
  return 1
}

server_install() {
  local log_offset status
  require_macos
  require_command curl
  require_command launchctl
  require_command lsof
  check_host
  require_current_server_agent
  if server_loaded; then
    die "$SERVER_LABEL is already loaded; use server-restart"
  else
    status=$?
    [[ "$status" -eq 1 ]] || die 'could not determine native LaunchAgent state'
  fi
  require_safe_launch_agent_target "$SERVER_PLIST_TARGET"
  install -m 600 "$SERVER_PLIST_STATE" "$SERVER_PLIST_TARGET"
  log_offset="$(server_log_offset)"
  launchctl enable "gui/$(id -u)/$SERVER_LABEL"
  if ! launchctl bootstrap "gui/$(id -u)" "$SERVER_PLIST_TARGET"; then
    rollback_start_or_die "$SERVER_LABEL"
    die 'native LaunchAgent bootstrap failed and was disabled again'
  fi
  if ! wait_for_socket; then
    rollback_start_or_die "$SERVER_LABEL"
    wait_for_socket_absent >/dev/null 2>&1 || true
    report_server_start_failure "$log_offset"
    die 'native LaunchAgent did not become ready and was disabled again'
  fi
  printf 'Loaded %s; the native server is ready on its private Unix socket.\n' "$SERVER_LABEL"
  report_degraded_start "$log_offset"
}

server_start() {
  local log_offset status
  require_macos
  require_command curl
  require_command launchctl
  require_command lsof
  check_host
  require_current_server_agent
  require_safe_launch_agent_target "$SERVER_PLIST_TARGET"
  [[ -f "$SERVER_PLIST_TARGET" ]] ||
    die "the installed LaunchAgent is missing; run server-install first: $SERVER_PLIST_TARGET"
  cmp -s "$SERVER_PLIST_STATE" "$SERVER_PLIST_TARGET" ||
    die 'the installed native LaunchAgent is stale; run server-install while it is stopped'
  if server_loaded; then
    server_ready || die 'LaunchAgent is loaded but its Unix socket is not ready or is not owned by its stable PID'
    printf '%s is already loaded and ready.\n' "$SERVER_LABEL"
    return
  else
    status=$?
    [[ "$status" -eq 1 ]] || die 'could not determine native LaunchAgent state'
  fi
  log_offset="$(server_log_offset)"
  launchctl enable "gui/$(id -u)/$SERVER_LABEL"
  if ! launchctl bootstrap "gui/$(id -u)" "$SERVER_PLIST_TARGET"; then
    rollback_start_or_die "$SERVER_LABEL"
    die 'native LaunchAgent bootstrap failed and was disabled again'
  fi
  if ! wait_for_socket; then
    rollback_start_or_die "$SERVER_LABEL"
    wait_for_socket_absent >/dev/null 2>&1 || true
    report_server_start_failure "$log_offset"
    die 'native LaunchAgent did not become ready and was disabled again'
  fi
  printf 'Loaded %s; the native server is ready on its private Unix socket.\n' "$SERVER_LABEL"
  report_degraded_start "$log_offset"
}

server_stop() {
  local confirmation="$1" status
  [[ "$confirmation" == 'STOP IMESSAGE PROXY SERVER' ]] ||
    die 'server-stop confirmation did not match'
  require_macos
  require_safe_runtime_root
  require_command launchctl
  if server_loaded; then
    launchctl disable "gui/$(id -u)/$SERVER_LABEL"
    launchctl bootout "gui/$(id -u)/$SERVER_LABEL"
    wait_for_service_absent "$SERVER_LABEL" || die 'native LaunchAgent did not unload cleanly'
    wait_for_socket_absent ||
      die "native LaunchAgent stopped but port $IMESSAGE_PROXY_PORT is still in use; inspect before continuing"
    printf 'Stopped %s. Its installed plist and all runtime state were preserved.\n' "$SERVER_LABEL"
  else
    status=$?
    [[ "$status" -eq 1 ]] || die 'could not determine native LaunchAgent state'
    launchctl disable "gui/$(id -u)/$SERVER_LABEL"
    server_port_free ||
      die "native LaunchAgent is absent but port $IMESSAGE_PROXY_PORT is still in use; inspect before continuing"
    printf '%s is already stopped.\n' "$SERVER_LABEL"
  fi
}

server_restart() {
  local confirmation="$1" log_offset
  [[ "$confirmation" == 'RESTART IMESSAGE PROXY SERVER' ]] ||
    die 'server-restart confirmation did not match'
  require_macos
  require_command curl
  require_command launchctl
  require_command lsof
  check_host
  require_current_server_agent
  server_loaded || die "$SERVER_LABEL is not loaded"
  require_safe_launch_agent_target "$SERVER_PLIST_TARGET"
  install -m 600 "$SERVER_PLIST_STATE" "$SERVER_PLIST_TARGET"
  log_offset="$(server_log_offset)"
  launchctl enable "gui/$(id -u)/$SERVER_LABEL"
  if ! launchctl bootout "gui/$(id -u)/$SERVER_LABEL"; then
    launchctl disable "gui/$(id -u)/$SERVER_LABEL" >/dev/null 2>&1 || true
    die 'native LaunchAgent could not be unloaded; its label was disabled for recovery'
  fi
  wait_for_service_absent "$SERVER_LABEL" || die 'native LaunchAgent did not unload cleanly'
  wait_for_socket_absent || die 'the old native Unix socket did not disappear after stop'
  if ! launchctl bootstrap "gui/$(id -u)" "$SERVER_PLIST_TARGET"; then
    rollback_start_or_die "$SERVER_LABEL"
    die 'native LaunchAgent restart bootstrap failed and was disabled again'
  fi
  if ! wait_for_socket; then
    rollback_start_or_die "$SERVER_LABEL"
    wait_for_socket_absent >/dev/null 2>&1 || true
    report_server_start_failure "$log_offset"
    die 'restarted native LaunchAgent was not ready and was disabled again'
  fi
  printf 'Restarted %s on http://127.0.0.1:%s\n' "$SERVER_LABEL" "$IMESSAGE_PROXY_PORT"
  report_degraded_start "$log_offset"
}

server_status() {
  local snapshot status
  require_macos
  require_safe_runtime_root
  require_command curl
  require_command launchctl
  require_command lsof
  require_api_settings
  require_current_server_agent
  require_safe_launch_agent_target "$SERVER_PLIST_TARGET"
  [[ -f "$SERVER_PLIST_TARGET" ]] ||
    die "the installed native LaunchAgent is missing: $SERVER_PLIST_TARGET"
  cmp -s "$SERVER_PLIST_STATE" "$SERVER_PLIST_TARGET" ||
    die 'the installed native LaunchAgent does not match current staged configuration'
  if snapshot="$(launchctl_snapshot "$SERVER_LABEL")"; then
    printf '%s\n' "$snapshot"
    server_ready || die 'LaunchAgent is loaded but its Unix socket is not ready or is not owned by its stable PID'
  else
    status=$?
    [[ "$status" -eq 1 ]] && die "$SERVER_LABEL is not loaded"
    die 'could not inventory native LaunchAgent state'
  fi
}

require_port_free() {
  local port="$1"
  port_is_free "$port" || die "TCP port $port already has a listener"
}

require_staged_imsg() {
  local actual version_output
  require_private_executable "$IMSG_BIN" 'staged imsg binary'
  [[ "${IMESSAGE_PROXY_IMSG_SHA256:-}" =~ ^[0-9a-f]{64}$ ]] ||
    die 'IMESSAGE_PROXY_IMSG_SHA256 must be the reviewed staged-binary digest'
  actual="$(shasum -a 256 "$IMSG_BIN" | awk '{print $1}')"
  [[ "$actual" == "$IMESSAGE_PROXY_IMSG_SHA256" ]] ||
    die 'the staged imsg binary digest is not the reviewed digest'
  version_output="$("$IMSG_BIN" --version 2>/dev/null)" ||
    die 'the staged imsg binary did not report a version'
  [[ "$version_output" == "$EXPECTED_IMSG_VERSION" ]] ||
    die 'the staged imsg version is not the reviewed version'
  # The version this just proved is the one thing an incomplete payload still
  # answers correctly, so it proves nothing about sending on its own.
  require_imsg_payload "$IMSG_BIN" 'staged imsg'
}

server_logs() {
  require_macos
  require_safe_runtime_root
  require_command tail
  require_server_log
  printf '%s\n' '--- bounded native server log (last 100 lines) ---'
  tail -n 100 "$SERVER_LOG"
}

doctor() {
  local command failed=0
  require_macos
  require_safe_runtime_root
  printf 'iMessage Proxy %s\n' "$VERSION"
  if (require_sources); then
    printf 'OK   source assets: %s\n' "$SOURCE_DIR"
  else
    failed=1
  fi
  for command in awk clang codesign cmp curl ifconfig launchctl lsof plutil sed shasum sqlite3 stat xcrun; do
    if command -v "$command" >/dev/null 2>&1; then
      printf 'OK   command: %s\n' "$command"
    else
      printf 'FAIL command: %s\n' "$command" >&2
      failed=1
    fi
  done
  if (require_imsg_source >/dev/null 2>&1); then
    printf 'OK   imsg %s source binary and SHA-256 pin\n' "$EXPECTED_IMSG_VERSION"
  else
    printf 'FAIL imsg %s source binary or SHA-256 pin\n' "$EXPECTED_IMSG_VERSION" >&2
    failed=1
  fi
  if (require_api_settings); then
    printf 'OK   service port %s\n' "$IMESSAGE_PROXY_PORT"
  else
    failed=1
  fi
  report_messages_read_mode
  # A send-only installation never opens this database, so judging it would fail
  # a Mac that is configured exactly as its owner intended - and bootstrap, which
  # runs doctor first, would refuse to install on one.
  if messages_read_enabled; then
    case "$(messages_database_status)" in
      ok) printf 'OK   Messages database: %s\n' "$MESSAGES_DATABASE_PATH" ;;
      missing)
        printf 'FAIL no Messages database at %s\n' "$MESSAGES_DATABASE_PATH" >&2
        printf 'FAIL open Messages, sign in to iMessage, and exchange one message\n' >&2
        failed=1
        ;;
      symlinked)
        printf 'FAIL the Messages database must not be a symlink: %s\n' "$MESSAGES_DATABASE_PATH" >&2
        failed=1
        ;;
      foreign)
        printf 'FAIL the Messages database must belong to %s: %s\n' "$(id -un)" "$MESSAGES_DATABASE_PATH" >&2
        failed=1
        ;;
      unreadable)
        printf 'WARN could not inspect %s from this terminal\n' "$MESSAGES_DATABASE_PATH" >&2
        printf 'WARN this limits only this check; the service uses its own Full Disk Access grant\n' >&2
        ;;
    esac
  fi
  printf 'INFO state: %s\n' "$ROOT"
  return "$failed"
}

main() {
  [[ $# -ge 1 ]] || { usage; exit 64; }
  # bootstrap loads the configuration it was pointed at; version and help need
  # none. Everything else operates on an installed service and reads the
  # reviewed configuration that installed it.
  case "$1" in
    bootstrap | version | -h | --help) ;;
    *) use_service_config ;;
  esac
  case "$1" in
    doctor) [[ $# -eq 1 ]] || die 'doctor takes no arguments'; doctor ;;
    bootstrap) shift; bootstrap "$@" ;;
    prepare) [[ $# -eq 1 ]] || die 'prepare takes no arguments'; prepare ;;
    build-host) [[ $# -eq 1 ]] || die 'build-host takes no arguments'; build_host ;;
    check-host) [[ $# -eq 1 ]] || die 'check-host takes no arguments'; check_host ;;
    api-key) shift; api_key "$@" ;;
    targets) shift; targets "${@:-list}" ;;
    send-test) [[ $# -eq 2 ]] || die 'send-test requires one recipient'; send_test "$2" ;;
    enable-messages-read)
      [[ $# -eq 1 ]] || die 'enable-messages-read takes no arguments'
      enable_messages_read
      ;;
    disable-messages-read)
      [[ $# -eq 3 && "$2" == --confirm ]] || die 'disable-messages-read requires --confirm TEXT'
      disable_messages_read "$3"
      ;;
    server-install) [[ $# -eq 1 ]] || die 'server-install takes no arguments'; server_install ;;
    server-start) [[ $# -eq 1 ]] || die 'server-start takes no arguments'; server_start ;;
    server-stop)
      [[ $# -eq 3 && "$2" == --confirm ]] || die 'server-stop requires --confirm TEXT'
      server_stop "$3"
      ;;
    server-restart)
      [[ $# -eq 3 && "$2" == --confirm ]] || die 'server-restart requires --confirm TEXT'
      server_restart "$3"
      ;;
    server-status) [[ $# -eq 1 ]] || die 'server-status takes no arguments'; server_status ;;
    server-logs) [[ $# -eq 1 ]] || die 'server-logs takes no arguments'; server_logs ;;
    version) [[ $# -eq 1 ]] || die 'version takes no arguments'; printf '%s\n' "$VERSION" ;;
    -h | --help) usage ;;
    *) usage >&2; exit 64 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
